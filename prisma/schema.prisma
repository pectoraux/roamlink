// =============================================================================
// eSIM Marketplace — Prisma Schema
// -----------------------------------------------------------------------------
// DATABASE: SQLite is used in development (sandbox constraint). Money is stored
// as Int (minor units) — never float.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// User & Authentication
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  role          String   @default("customer") // "customer" | "admin"
  isDemo        Boolean  @default(false) // demo accounts (quick-login)
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions              Session[]
  orders                Order[]
  esims                 Esim[]
  payments              Payment[]
  topUps                TopUp[]
  auditLogs             AuditLog[]
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  approvedFrom          WaitlistEntry?
  approvedWaitlist      WaitlistEntry[] @relation("WaitlistApprover")
  orgMemberships        OrganizationMember[]
  virtualNumbers        VirtualNumber[]
  numberSubscriptions   NumberSubscription[]
  financialTxns         FinancialTransaction[]
  referral              Referral?             @relation("ReferralUser")
  referralUses          ReferralUse[]          @relation("RefereeUser")
  credit                CustomerCredit?
  creditTxns            CreditTransaction[]
}

model WaitlistEntry {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  status      String   @default("pending") // pending | approved | rejected
  note        String?  // admin note
  approvedById String? // admin user who approved
  approvedAt  DateTime?
  createdUserId String? @unique // the User created when approved (1:1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  approvedBy  User?    @relation("WaitlistApprover", fields: [approvedById], references: [id])
  createdUser User?    @relation(fields: [createdUserId], references: [id])

  @@index([status])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  // Phase 2B: active tenant context for reseller control plane.
  // Validated server-side against TenantUser membership on every request.
  activeTenantId String?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Plans (canonical marketplace model — never provider-native shape)
// ---------------------------------------------------------------------------

model Plan {
  id              String   @id @default(cuid())
  providerId      String   // internal provider key, e.g. "mock"
  providerPlanId  String   // provider's native plan id
  name            String
  description     String?
  country         String
  countryCode     String   // ISO 3166-1 alpha-2
  region          String   // e.g. "Africa", "Europe", "North America"
  dataAmount      Int      // in MB (1024 = 1 GB)
  dataUnit        String   @default("MB")
  validityDays    Int
  // Money — integer minor units (cents). See lib/money.ts.
  price           Int      // retail price in minor units
  wholesalePrice  Int      // internal cost, NEVER exposed to customers
  currency        String   @default("USD")
  coverage        String?  // comma-separated countries / description
  networks        String?  // JSON string: ["MTN","Vodafone"]
  roaming         Boolean  @default(false)
  hotspot         Boolean  @default(true)
  speed           String?  // e.g. "4G/5G"
  topUpSupported  Boolean  @default(true)
  status          String   @default("active") // "active" | "inactive"
  // Pricing rule that produced `price` (audit). JSON string.
  pricingRule     String?
  // Provider-native payload (never sent to client). JSON string.
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          Order[]

  @@unique([providerId, providerPlanId])
  @@index([countryCode])
  @@index([region])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id               String   @id @default(cuid())
  userId           String
  planId           String?  // nullable for virtual-number orders (no Plan row)
  productType      String   @default("esim") // esim | virtual_number
  // State machine: PLAN_SELECTED | CHECKOUT_CREATED | PAYMENT_PENDING |
  // PAYMENT_CONFIRMED | ESIM_PROVISIONING | ESIM_PROVISIONED | COMPLETED |
  // PAYMENT_FAILED | PROVISIONING_FAILED | CANCELLED | REFUNDED
  status           String   @default("PLAN_SELECTED")
  amount           Int      // total charged (minor units) — frozen from DistributionOffer
  currency         String   @default("USD")
  paymentStatus    String   @default("pending") // pending | succeeded | failed | refunded
  paymentProvider  String?
  paymentReference String?  // provider's payment intent / charge id
  providerOrderId  String?  // eSIM provider order id
  // Idempotency: prevents duplicate orders / payments / provisioning on retry.
  idempotencyKey   String   @unique
  // Snapshot of plan at purchase time (so historical orders stay accurate).
  planSnapshot     String?  // JSON string
  failureReason    String?
  // --- Phase 2C: Connectivity Orchestration Convergence ---
  tenantId         String?  // null = RoamLink Direct
  // Phase 2B: links the order to a reseller's customer + the distribution offer
  // that set the retail price. Both are nullable for RoamLink Direct orders.
  tenantCustomerId String?
  distributionOfferId String?
  fulfillmentStatus String  @default("pending") // pending|provisioning|success|failed|unknown|reconciliation_required
  financialStatus  String   @default("pending") // pending | settled | failed
  fulfillmentExternalReference String? // provider's external fulfillment ref
  fulfillmentEntityId String?  // id of persisted fulfillment entity (e.g. Esim.id)
  supplierOfferId  String?  // the ConnectivityOffer selected by the orchestrator
  frozenSupplierProductId String? // the supplierProductId frozen at selection time
  frozenProviderKey String? // the providerKey frozen at selection time (NOT re-read from live Supplier)
  frozenWholesalePriceMinor Int? // the wholesale price frozen at selection time (NOT re-read from live Offer)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             Plan?    @relation(fields: [planId], references: [id])
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  payments         Payment[]
  esim             Esim?
  corporateOrder   CorporateOrder?
  virtualNumber    VirtualNumber? @relation("VirtualNumberOrder")
  financialTxns    FinancialTransaction[] @relation("FinancialOrder")
  promoRedemption  PromoRedemption?       @relation("PromoOrder")

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id               String   @id @default(cuid())
  userId           String
  orderId          String
  amount           Int
  currency         String   @default("USD")
  status           String   @default("pending") // pending | succeeded | failed | refunded
  provider         String
  providerReference String?
  // Idempotency key from the client payment attempt.
  idempotencyKey   String?  @unique
  raw              String?  // provider response (server-side only), JSON string
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// eSIMs
// ---------------------------------------------------------------------------

model Esim {
  id              String    @id @default(cuid())
  userId          String
  orderId         String    @unique // one eSIM per order (1:1)
  provider        String
  providerESIMId  String?   // provider's native esim id
  iccid           String?   // 19-20 digit Integrated Circuit Card ID
  smdpAddress     String?   // SM-DP+ server address
  activationCode  String?   // LPA activation code
  matchId         String?   // optional confirmation code
  qrCode          String?   // generated QR payload (LPA string)
  status          String    @default("pending") // pending|active|expired|suspended|exhausted|cancelled
  dataAmount      Int       // total allowance in MB
  dataRemaining   Int       // remaining in MB
  validityDays    Int
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  usages          Usage[]
  topUps          TopUp[]
  orgAssignments  OrganizationESIM[]

  @@index([userId])
  @@index([status])
  @@index([iccid])
}

// ---------------------------------------------------------------------------
// Usage tracking
// ---------------------------------------------------------------------------

model Usage {
  id            String   @id @default(cuid())
  esimId        String
  dataUsed      Int      // MB used in this sample
  dataRemaining Int      // MB remaining at sample time
  source        String   @default("provider") // provider | simulated
  timestamp     DateTime @default(now())

  esim          Esim     @relation(fields: [esimId], references: [id], onDelete: Cascade)

  @@index([esimId])
}

// ---------------------------------------------------------------------------
// Top-ups
// ---------------------------------------------------------------------------

model TopUp {
  id               String   @id @default(cuid())
  esimId           String
  userId           String
  amount           Int      // charged (minor units)
  currency         String   @default("USD")
  dataAmount       Int      // MB added
  paymentStatus    String   @default("pending") // pending | succeeded | failed
  providerReference String?
  idempotencyKey   String   @unique
  createdAt        DateTime @default(now())

  esim             Esim     @relation(fields: [esimId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([esimId])
}

// ---------------------------------------------------------------------------
// Webhook events (idempotent delivery log)
// ---------------------------------------------------------------------------

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventType   String
  externalId  String?  // provider's event id, used for dedup
  payload     String   // JSON string
  processed   Boolean  @default(false)
  error       String?
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@unique([provider, externalId])
  @@index([provider, eventType])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  orderId   String?
  // Phase 2B: tenant-scoped audit trail for reseller operations.
  tenantId  String?
  action    String
  entity    String   // order | esim | payment | plan | user | tenant | tenant_customer | distribution_offer | api_key
  entityId  String?
  detail    String?  // JSON string
  ip        String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Pricing rules (markup engine)
// ---------------------------------------------------------------------------

model PricingRule {
  id         String   @id @default(cuid())
  name       String
  type       String   // "fixed" | "percentage"
  value      Int      // fixed: minor units; percentage: basis points (30% = 3000)
  scope      String   @default("global") // global | country | region
  scopeValue String?  // countryCode / region when scoped
  priority   Int      @default(0) // higher wins
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([scope, scopeValue])
}

// ---------------------------------------------------------------------------
// Notifications log (development implementation)
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  channel   String   // email | sms | push | whatsapp | log
  event     String
  recipient String?
  subject   String?
  body      String
  status    String   @default("sent") // sent | failed
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([event])
}

// ---------------------------------------------------------------------------
// Installation tokens — short-lived, secure tokens for web→mobile deep linking.
// A web purchase generates a token; the mobile app consumes it to install the
// eSIM. Never expose raw activation secrets in permanent URLs.
// ---------------------------------------------------------------------------

model InstallToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  esimId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([esimId])
}

// ---------------------------------------------------------------------------
// B2B foundation — organizations, members, corporate eSIMs.
// Built as a foundation so corporate features can be added without redesigning
// authentication. Not fully implemented yet.
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active") // active | suspended
  // Billing
  billingEmail   String?
  // Spending limits (in minor units, 0 = unlimited)
  monthlySpendLimit Int   @default(0) // 0 = no limit
  currentMonthSpend Int  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  esims     OrganizationESIM[]
  orders    CorporateOrder[]
  numbers   VirtualNumber[] @relation("OrgNumbers")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member") // owner | admin | member
  // Per-member spending limit (0 = use org default, -1 = no purchases allowed)
  spendLimit     Int      @default(0) // minor units per month
  currentSpend   Int      @default(0) // spent this month
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationESIM {
  id             String   @id @default(cuid())
  organizationId String
  esimId         String
  assignedTo     String?  // employee name/email
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  esim           Esim        @relation(fields: [esimId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([esimId])
}

model CorporateOrder {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String   @unique
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Virtual Numbers — second connectivity product alongside eSIMs.
// Reuses: User, Organization, Order, Payment, WebhookEvent, AuditLog.
// ---------------------------------------------------------------------------

model VirtualNumber {
  id              String    @id @default(cuid())
  e164            String    @unique // e.g. "+233241234567"
  country         String
  countryCode     String
  region          String?
  city            String?
  numberType      String    @default("local") // local | toll_free | mobile | national
  smsEnabled      Boolean   @default(false)
  mmsEnabled      Boolean   @default(false)
  voiceEnabled    Boolean   @default(false)
  // Lifecycle: discovered | available | reserved | provisioning | configuring | active | suspended | releasing | released | failed
  status          String    @default("available")
  provider        String    // e.g. "mock", "telnyx", "twilio"
  providerNumberId String?  // provider's native number id
  providerCost    Int       // wholesale cost in minor units (monthly)
  sellingPrice    Int       // customer price in minor units (monthly)
  currency        String    @default("USD")
  userId          String?
  organizationId  String?
  orderId         String?   @unique // 1:1 with the order that purchased it
  activatedAt     DateTime?
  releasedAt      DateTime?
  expiresAt       DateTime? // subscription expiry
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  order           Order?          @relation("VirtualNumberOrder", fields: [orderId], references: [id], onDelete: SetNull)
  organization    Organization?   @relation("OrgNumbers", fields: [organizationId], references: [id], onDelete: SetNull)
  messages        Message[]
  calls           Call[]
  subscriptions   NumberSubscription[]

  @@index([userId])
  @@index([organizationId])
  @@index([countryCode])
  @@index([status])
}

model NumberSubscription {
  id              String    @id @default(cuid())
  virtualNumberId String
  userId          String
  status          String    @default("active") // active | past_due | suspended | cancelled | expired | trial | reconciliation_required
  billingCycle    String    @default("monthly") // monthly | yearly
  currentPeriodEnd DateTime
  trialEndsAt     DateTime?
  cancelledAt     DateTime?
  idempotencyKey  String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  virtualNumber   VirtualNumber @relation(fields: [virtualNumberId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  renewalCycles   SubscriptionRenewalCycle[]

  @@index([userId])
  @@index([virtualNumberId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Subscription Renewal Cycle — durable identity for each renewal attempt.
// Phase 2E.4: The renewal cycle identity is stable across retries. It does
// NOT depend on mutable currentPeriodEnd. If a renewal partially succeeds
// (financial posted, domain partially updated), the retry uses the SAME
// cycle identity — no duplicate financial transaction, no duplicate extension.
// ---------------------------------------------------------------------------

model SubscriptionRenewalCycle {
  id              String   @id @default(cuid())
  subscriptionId  String
  // The IMMUTABLE period boundaries for this renewal cycle.
  // periodStart = the currentPeriodEnd BEFORE renewal.
  // periodEnd = the target currentPeriodEnd AFTER renewal.
  periodStart     DateTime
  periodEnd       DateTime
  // The stable identity used for idempotency keys and ledger references.
  cycleKey        String   @unique // e.g. "renewal_{subId}_{periodStart.getTime()}"
  // State machine: pending → payment_confirmed → financial_posted → domain_updated → completed
  //                pending → failed
  //                financial_posted → reconciliation_required (if domain update fails)
  state           String   @default("pending") // pending | payment_confirmed | financial_posted | domain_updated | completed | reconciliation_required | failed
  // Financial tracking
  paidFromCreditMinor Int  @default(0)
  paidFromCashMinor    Int  @default(0)
  paymentFeeMinor      Int  @default(0)
  // Error tracking for retries
  lastError       String?
  retryCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscription    NumberSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([state])
  @@index([periodStart])
}

model Message {
  id              String   @id @default(cuid())
  virtualNumberId String
  direction       String   // inbound | outbound
  fromNumber      String
  toNumber        String
  body            String
  status          String   @default("received") // received | sent | delivered | failed
  providerMessageId String?
  segments        Int      @default(1)
  createdAt       DateTime @default(now())

  virtualNumber   VirtualNumber @relation(fields: [virtualNumberId], references: [id], onDelete: Cascade)

  @@index([virtualNumberId])
  @@index([createdAt])
}

model Call {
  id              String   @id @default(cuid())
  virtualNumberId String
  direction       String   // inbound | outbound
  fromNumber      String
  toNumber        String
  status          String   @default("completed") // ringing | in_progress | completed | failed | no_answer | busy
  durationSeconds Int      @default(0)
  providerCallId  String?
  recordingUrl    String?
  createdAt       DateTime @default(now())

  virtualNumber   VirtualNumber @relation(fields: [virtualNumberId], references: [id], onDelete: Cascade)

  @@index([virtualNumberId])
  @@index([createdAt])
}

model TrialPolicy {
  id              String   @id @default(cuid())
  name            String   @unique
  durationHours   Int      @default(24)
  maxNumbers      Int      @default(1)
  maxInboundSMS   Int      @default(3)
  maxOutboundSMS  Int      @default(0)
  maxInboundMinutes Int    @default(5)
  maxOutboundMinutes Int   @default(0)
  apiAllowed      Boolean  @default(false)
  eligibleCountries String? // comma-separated country codes, null = all
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CountryCapability {
  id              String   @id @default(cuid())
  countryCode     String   @unique
  country         String
  smsAllowed      Boolean  @default(true)
  voiceAllowed    Boolean  @default(true)
  mmsAllowed      Boolean  @default(false)
  identityRequired Boolean @default(false)
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Financial Ledger — immutable record of all financial events.
// Financial truth must not depend exclusively on mutable order records.
// ---------------------------------------------------------------------------

model FinancialTransaction {
  id              String   @id @default(cuid())
  type            String   // CUSTOMER_PAYMENT | PAYMENT_FEE | PROVIDER_PURCHASE | PROVIDER_LIABILITY | PROVIDER_INVOICE | PROVIDER_PAYMENT | REFUND | CHARGEBACK | PROMOTIONAL_CREDIT | CUSTOMER_CREDIT | TRIAL_COST | COMMISSION | ADJUSTMENT
  userId          String?
  organizationId  String?
  orderId         String?
  provider        String?  // esim provider or payment provider
  providerTxnId   String?  // provider's transaction id
  amountMinor     Int      // positive = debit (cost), negative = credit (revenue). In minor units.
  currency        String   @default("USD")
  // Financial breakdown (all in minor units, may be 0 if not applicable)
  customerPrice   Int      @default(0)  // what customer paid
  providerCost    Int      @default(0)  // wholesale cost
  paymentFee      Int      @default(0)  // payment processing fee
  grossProfit     Int      @default(0)  // customerPrice - providerCost
  contributionProfit Int   @default(0)  // grossProfit - paymentFee - refundCost - fraudLoss
  refundCost      Int      @default(0)
  fraudLoss       Int      @default(0)
  // Metadata
  source          String   @default("system") // system | admin | provider | webhook
  reason          String?
  state           String   @default("pending") // pending | settled | disputed | reversed
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())
  settledAt       DateTime?

  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  order           Order?         @relation("FinancialOrder", fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Provider Credit Account — tracks provider credit facilities (e.g., Airalo $10K).
// This is a financial liability, NOT cash. Must be tracked for risk control.
// ---------------------------------------------------------------------------

model ProviderCreditAccount {
  id              String   @id @default(cuid())
  provider        String   @unique // e.g. "airalo", "mock"
  creditLimit     Int      // in minor units (e.g., 1000000 = $10,000)
  currency        String   @default("USD")
  outstandingLiability Int  @default(0) // accumulated unbilled provider purchases
  pendingCommitments Int   @default(0) // in-flight provider orders not yet confirmed
  invoicedAmount  Int      @default(0) // amount invoiced by provider
  paidAmount      Int      @default(0) // amount paid to provider
  // Thresholds (percentage of credit limit)
  thresholdInfo   Int      @default(50) // informational
  thresholdWarn   Int      @default(75) // warning
  thresholdElevated Int    @default(80) // elevated
  thresholdCritical Int    @default(90) // critical — restrict new commitments
  thresholdEmergency Int   @default(95) // emergency
  // State
  active          Boolean  @default(true)
  lastInvoiceDate DateTime?
  nextPaymentDue  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoices        ProviderInvoice[]
}

model ProviderInvoice {
  id              String   @id @default(cuid())
  providerAccountId String
  providerInvoiceId String? @unique // provider's invoice number
  amountMinor     Int      // invoiced amount in minor units
  currency        String   @default("USD")
  status          String   @default("pending") // pending | paid | overdue | disputed
  periodStart     DateTime?
  periodEnd       DateTime?
  dueDate         DateTime?
  paidAt          DateTime?
  // Reconciliation
  reconciledTransactions Int @default(0)
  mismatchedTransactions  Int @default(0)
  reconciled      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  providerAccount ProviderCreditAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)

  @@index([providerAccountId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Pricing Snapshot — preserves the pricing used for each transaction so
// historical economics can't be retroactively changed.
// ---------------------------------------------------------------------------

model PricingSnapshot {
  id              String   @id @default(cuid())
  orderId         String?  @unique
  productId       String?  // planId or virtualNumberId
  productType     String   // esim | virtual_number
  wholesaleMinor  Int      // provider cost at time of purchase
  retailMinor     Int      // customer price at time of purchase
  currency        String   @default("USD")
  markupPercent   Float    // (retail - wholesale) / wholesale * 100
  grossMarginPercent Float // (retail - wholesale) / retail * 100
  pricingRule     String?  // JSON of the rule that produced this price
  createdAt       DateTime @default(now())

  @@index([productType])
}

// ---------------------------------------------------------------------------
// Promo Codes — promotional discounts at checkout.
// ---------------------------------------------------------------------------

model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. "TRAVEL20"
  description     String?
  type            String   // "percentage" | "fixed"
  value           Int      // percentage: 20 = 20% off; fixed: 500 = $5.00 off (minor units)
  currency        String   @default("USD")
  minOrderAmount  Int      @default(0) // minimum order amount in minor units (0 = no minimum)
  maxDiscount     Int?     // cap on discount amount (minor units, null = no cap)
  maxUses         Int?     // null = unlimited
  maxUsesPerUser  Int      @default(1)
  usesCount       Int      @default(0)
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  active          Boolean  @default(true)
  // Profitability guardrail
  minMarginPercent Float?  // reject if discount would push margin below this
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions     PromoRedemption[]

  @@index([active])
}

model PromoRedemption {
  id              String   @id @default(cuid())
  promoCodeId     String
  orderId         String   @unique
  userId          String
  discountAmount  Int      // actual discount applied (minor units)
  currency        String   @default("USD")
  createdAt       DateTime @default(now())

  promoCode       PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  order           Order     @relation("PromoOrder", fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([promoCodeId])
}

// ---------------------------------------------------------------------------
// Referrals — customer referral codes + credit rewards.
// ---------------------------------------------------------------------------

model Referral {
  id              String   @id @default(cuid())
  referrerUserId  String   @unique // each user has one referral code
  referralCode    String   @unique // e.g. "ROAM-ABC123"
  // Reward config (in minor units)
  referrerReward  Int      @default(200) // $2.00 credit for referrer
  refereeReward   Int      @default(200) // $2.00 credit for referee
  currency        String   @default("USD")
  // Stats
  totalReferrals  Int      @default(0)
  completedReferrals Int   @default(0) // referee made a purchase
  totalRewardPaid Int      @default(0)
  createdAt       DateTime @default(now())

  referrer        User     @relation("ReferralUser", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referrals       ReferralUse[]

  @@index([referrerUserId])
}

model ReferralUse {
  id              String   @id @default(cuid())
  referralId      String
  refereeUserId   String
  orderId         String?  // first purchase that completed the referral
  status          String   @default("pending") // pending | completed | rejected
  referrerCredited Boolean @default(false)
  refereeCredited Boolean @default(false)
  createdAt       DateTime @default(now())

  referral        Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referee         User     @relation("RefereeUser", fields: [refereeUserId], references: [id], onDelete: Cascade)

  @@unique([referralId, refereeUserId])
  @@index([refereeUserId])
}

// ---------------------------------------------------------------------------
// Customer Credit / Wallet — unified balance across products.
// ---------------------------------------------------------------------------

model CustomerCredit {
  id              String   @id @default(cuid())
  userId          String   @unique
  balanceMinor    Int      @default(0) // current balance in minor units
  currency        String   @default("USD")
  totalEarned     Int      @default(0) // lifetime credits earned
  totalSpent      Int      @default(0) // lifetime credits spent
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    CreditTransaction[]

  @@index([userId])
}

model CreditTransaction {
  id              String   @id @default(cuid())
  creditId        String
  userId          String
  type            String   // referral_reward | promo_credit | admin_adjustment | purchase_credit | refund_credit
  amountMinor     Int      // positive = credit added, negative = credit spent
  balanceAfter    Int      // balance after this transaction
  reason          String?
  orderId         String?
  referrerId      String?
  createdAt       DateTime @default(now())

  credit          CustomerCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phase 2E.7: Unique constraint for spend idempotency.
  // For spending (type = "purchase_credit"), (userId, orderId, type) must be unique.
  // For issuance, the CreditIssuance model provides the idempotency identity.
  // This constraint prevents duplicate spending for the same business event.
  @@unique([userId, orderId, type])
  @@index([userId])
  @@index([creditId])
}

// ---------------------------------------------------------------------------
// Credit Issuance — durable, idempotent credit issuance lifecycle.
// Phase 2E.7: Ensures credit issuance cannot silently diverge from the ledger.
// The issuance has a stable identity, a state machine, and tracks both the
// operational credit transaction and the financial ledger transaction.
// ---------------------------------------------------------------------------

model CreditIssuance {
  id                  String   @id @default(cuid())
  userId              String
  amountMinor         Int
  sourceType          String   // referral_reward | promo_credit | admin_adjustment | refund_credit
  sourceId            String   // referralUseId | promoCodeId | adminOperationId | refundId
  idempotencyKey      String   @unique // stable business identity
  status              String   @default("pending") // pending | posted | completed | reconciliation_required
  creditTransactionId String?
  ledgerTransactionId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([sourceType, sourceId])
  @@index([status])
}

// ===========================================================================
// Phase 2C — Connectivity Orchestration Convergence
// ===========================================================================
// These models make Tenant, DistributionOffer, canonical product identity,
// and the orchestration engine load-bearing in the real purchase path.
//
//   Plan (legacy provider-native catalog)
//     → ConnectivityProduct (canonical, identity-hashed)
//       → ConnectivityOffer (per-Supplier wholesale price)
//       → DistributionOffer (per-Tenant retail price — what the customer pays)
//     → Order (captures canonicalProductId + distributionOfferId at checkout)
//       → Orchestrator selects a ConnectivityOffer at fulfillment time
//       → FulfillmentAdapter provisions the product
//       → FulfillmentPersistenceHandler stores the entity (Esim, etc.)
//       → Double-entry ledger records the commercial transaction
// ===========================================================================

model ConnectivityProduct {
  id              String   @id @default(cuid())
  type            String   // ESIM | VIRTUAL_NUMBER | WIFI | LOCAL_DATA | BUNDLE
  name            String
  description     String?
  country         String?
  countryCode     String?
  region          String?
  dataAmountMB    Int?
  validityDays    Int?
  capabilities    String?
  sourcePlanId    String?  @unique
  canonicalSpecification String?
  identityHash    String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  offers          ConnectivityOffer[]
  distributionOffers DistributionOffer[]

  @@index([type])
  @@index([identityHash])
}

model Supplier {
  id              String   @id @default(cuid())
  name            String   @unique
  type            String
  providerKey     String?
  redistributionPolicy String @default("B2C_ONLY")
  supportedCapabilities String?
  healthStatus    String   @default("healthy")
  failureCount    Int      @default(0)
  successCount    Int      @default(0)
  lastFailureAt   DateTime?
  lastSuccessAt   DateTime?
  cooldownUntil   DateTime?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  offers          ConnectivityOffer[]
}

model ConnectivityOffer {
  id              String   @id @default(cuid())
  productId       String
  supplierId      String
  wholesalePrice  Int
  retailPrice     Int
  currency        String   @default("USD")
  status          String   @default("active")
  audiences       String   @default("B2C")
  availableIn     String?
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  supplierProductId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         ConnectivityProduct @relation(fields: [productId], references: [id])
  supplier        Supplier            @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([supplierId])
}

model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  status          String   @default("active")
  brandName       String?
  brandColor      String?
  customDomain    String?  @unique
  billingEmail    String?
  monthlySpendLimit Int    @default(0)
  defaultMarkupPercent Float @default(0)
  apiKey          String?  @unique
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  distributionOffers DistributionOffer[]
  orders          Order[]
  users           TenantUser[]
  // Phase 2B: reseller control plane relations
  customers       TenantCustomer[]
  subscription    TenantSubscription?
  apiKeys         ApiKey[]
  // Phase 2B.1: reseller balance + transactions
  balance         TenantBalance?
  transactions    TenantTransaction[]
  // Phase 2B.2: reservations + deposit payments
  reservations    TenantBalanceReservation[]
  depositPayments TenantDepositPayment[]
  // Phase 2B.3: SaaS invoices
  invoices        TenantInvoice[]
  // Phase 2C.1: connectivity entitlements
  entitlements    ConnectivityEntitlement[]
  // Phase 2C.3.1: connectivity provider instances
  providerInstances ConnectivityProviderInstance[]

  @@index([status])
}

model TenantUser {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  // Phase 2B: full reseller role set.
  // owner | admin | sales | support | billing | operations | viewer
  role            String   @default("admin")
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model DistributionOffer {
  id              String   @id @default(cuid())
  productId       String
  tenantId        String?  // null = RoamLink Direct
  retailPrice     Int
  currency        String   @default("USD")
  markupPercent   Float    @default(0)
  status          String   @default("active")
  audience        String   @default("B2C")
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         ConnectivityProduct @relation(fields: [productId], references: [id])
  tenant          Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([productId, tenantId])
  @@index([productId])
  @@index([tenantId])
}

model ProviderCreditReservation {
  id              String   @id @default(cuid())
  reservationId   String   @unique
  provider        String
  amountMinor     Int
  status          String   @default("reserved") // reserved | settled | released
  orderId         String?
  createdAt       DateTime @default(now())
  settledAt       DateTime?
  releasedAt      DateTime?

  @@index([provider, status])
}

model LedgerAccount {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  type            String
  normalBalance   String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  entries         LedgerEntry[]
}

model LedgerTransaction {
  id              String   @id @default(cuid())
  reference       String?
  type            String
  description     String?
  currency        String   @default("USD")
  status          String   @default("posted")
  idempotencyKey  String?  @unique
  userId          String?
  organizationId  String?
  orderId         String?
  provider        String?
  providerTxnId   String?
  createdAt       DateTime @default(now())
  postedAt        DateTime?
  entries         LedgerEntry[]

  @@index([orderId])
  @@index([type])
}

model LedgerEntry {
  id              String   @id @default(cuid())
  transactionId   String
  accountId       String
  direction       String
  amountMinor     Int
  currency        String   @default("USD")
  createdAt       DateTime @default(now())
  transaction     LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account         LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([transactionId])
}

// ===========================================================================
// Phase 2B — Reseller SaaS Control Plane
// ===========================================================================
// These models sit ON TOP OF the canonical connectivity platform. They do NOT
// replace Order, Ledger, ConnectivityProduct, or any existing primitive.
// A reseller (Tenant) operates their business through these models, which
// resolve down to the existing orchestration/fulfillment/ledger pipeline.
// ===========================================================================

// ---------------------------------------------------------------------------
// Tenant Customer — a reseller's customer (distinct from a RoamLink User).
// A TenantCustomer MAY have a linked RoamLink User account (for self-service),
// but can also exist as a reseller-managed record with no user account.
// A global RoamLink user may belong to multiple tenants' customer lists.
// ---------------------------------------------------------------------------

model TenantCustomer {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?  // optional link to a RoamLink User account
  name        String
  email       String
  phone       String?
  status      String   @default("active") // active | suspended | cancelled
  metadata    String?  // JSON string for extensible fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// SaaS Plan — configurable subscription tiers for resellers.
// ---------------------------------------------------------------------------

model SaaasPlan {
  id              String   @id @default(cuid())
  name            String   @unique // free | starter | business | enterprise
  displayName     String
  monthlyPriceMinor Int
  currency        String   @default("USD")
  includedStaff   Int      @default(1)
  includedCustomers Int    @default(10)
  includedOrdersPerMonth Int @default(100)
  platformFeePercent Float @default(0) // percentage of transaction taken as platform fee
  perOrderFeeMinor Int     @default(0) // flat fee per order in minor units
  features        String?  // JSON string of feature flags
  status          String   @default("active") // active | deprecated
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   TenantSubscription[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Tenant Subscription — a tenant's active SaaS subscription.
// Uses the same durable renewal-cycle machinery as connectivity subscriptions.
// ---------------------------------------------------------------------------

model TenantSubscription {
  id              String   @id @default(cuid())
  tenantId        String   @unique // one active subscription per tenant
  saaasPlanId     String
  status          String   @default("active") // active | past_due | cancelled | expired | trialing
  billingCycle    String   @default("monthly") // monthly | yearly
  currentPeriodEnd DateTime
  // Phase 2B.3: Payment lifecycle fields
  paymentProvider String?  // mock | stripe | paystack | flutterwave
  providerReference String? // provider's subscription/payment reference
  // Durable renewal identity (like SubscriptionRenewalCycle for connectivity)
  // Prevents duplicate renewal charges across retries
  renewalIdempotencyKey String?
  cancelledAt     DateTime?
  cancelReason    String?
  trialEndsAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saaasPlan       SaaasPlan @relation(fields: [saaasPlanId], references: [id])
  invoices        TenantInvoice[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 2B.3 — SaaS Invoice (receipt record for each subscription payment)
// ---------------------------------------------------------------------------

model TenantInvoice {
  id              String   @id @default(cuid())
  tenantId        String
  subscriptionId  String
  saaasPlanName   String   // snapshot of plan name at billing time
  amountMinor     Int
  currency        String   @default("USD")
  billingCycle    String   // monthly | yearly
  // Phase 2B.3.4: Nullable for unpaid invoices — no fake billing period.
  // Set to actual payment-time period when the invoice is paid.
  periodStart     DateTime?
  periodEnd       DateTime?
  status          String   @default("pending") // pending | paid | failed | refunded | reconciliation_required
  paymentProvider String?  // mock | stripe | paystack | flutterwave
  providerReference String? // provider's payment intent/charge reference
  ledgerTransactionId String?
  paidAt          DateTime?
  failureReason   String?
  idempotencyKey  String   @unique // durable identity (prevents duplicate invoices)
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription    TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// API Key — tenant-scoped API keys for programmatic access.
// ---------------------------------------------------------------------------

model ApiKey {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   // human-readable label
  hashedKey   String   @unique // bcrypt or sha256 hash of the raw key
  prefix      String   // first 8 chars shown in lists for identification
  scopes      String   @default("read") // JSON array: ["read","write","orders","customers"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdBy   String   // userId
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([hashedKey])
}

// ---------------------------------------------------------------------------
// Phase 2B.1 — Reseller Balance & Transactions
// ---------------------------------------------------------------------------

model TenantBalance {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  balanceMinor    Int      @default(0) // current prepaid balance in minor units
  currency        String   @default("USD")
  totalDepositedMinor Int  @default(0) // lifetime deposits
  totalSpentMinor Int      @default(0) // lifetime connectivity purchases
  // Phase 2B.2.7: Per-tenant monotonic sequence counter for TenantTransaction.
  // This is the authoritative sequence allocator — every TenantTransaction
  // creation locks this row (FOR UPDATE), reads nextTransactionSequence,
  // assigns it, and increments it. This prevents the MAX+1 race condition.
  nextTransactionSequence Int @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantTransaction {
  id              String   @id @default(cuid())
  tenantId        String
  type            String   // deposit | purchase | reservation | release | saas_payment | refund | adjustment
  amountMinor     Int      // positive = credit added, negative = debit
  balanceAfter    Int      // balance after this transaction
  orderId         String?  // linked order (for purchases)
  ledgerTransactionId String? // linked ledger transaction
  description     String?
  idempotencyKey  String   @unique // durable identity (prevents duplicate deposits/purchases)
  // Phase 2B.2.6: Per-tenant monotonic sequence number for deterministic
  // chronological ordering. Unlike createdAt (which can collide under concurrent
  // transactions), sequenceNumber provides a durable total order for financial
  // history reconstruction.
  sequenceNumber  Int
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sequenceNumber])
  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Phase 2B.2 — Reseller Balance Reservation + Deposit Payment Lifecycle
// ---------------------------------------------------------------------------

model TenantBalanceReservation {
  id              String   @id @default(cuid())
  tenantId        String
  orderId         String   @unique // one reservation per order
  amountMinor     Int      // reserved amount (retail price)
  platformFeeMinor Int     // platform fee at reservation time
  state           String   @default("RESERVED") // RESERVED | SETTLED | RELEASED | RECONCILIATION_REQUIRED
  idempotencyKey  String   @unique // durable identity
  ledgerTransactionId String? // ledger posting (set on SETTLE)
  releasedAt      DateTime?
  settledAt       DateTime?
  failureReason   String?
  // Phase 2B.2.3: Why the reservation is in RECONCILIATION_REQUIRED.
  // LEDGER_POSTING_FAILED | FULFILLMENT_UNKNOWN | TENANT_TRANSACTION_FAILED | OTHER
  // This distinguishes "ledger failed after successful fulfillment" (safe to retry settlement)
  // from "fulfillment state unknown" (must NOT settle until fulfillment is confirmed).
  reconciliationReason String?
  // Phase 2B.2.5: Marks whether the operational projection (TenantTransaction)
  // has been confirmed to exist. When false, the reconciliation worker should
  // check/repair it. When true, the worker skips it (scalability optimization).
  projectionReconciled Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([state])
  @@index([orderId])
}

model TenantDepositPayment {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  amountMinor     Int
  currency        String   @default("USD")
  paymentProvider String   // mock | paystack | flutterwave | stripe
  providerReference String? // provider's payment intent/charge reference
  status          String   @default("DEPOSIT_CREATED") // DEPOSIT_CREATED | PAYMENT_PENDING | PAYMENT_SUCCEEDED | PAYMENT_FAILED | BALANCE_POSTED | COMPLETED | CANCELLED | RECONCILIATION_REQUIRED
  idempotencyKey  String   @unique // durable identity for the deposit operation
  tenantTransactionId String? // linked TenantTransaction (set when balance is credited)
  ledgerTransactionId String? // linked ledger transaction
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([providerReference])
}

// ---------------------------------------------------------------------------
// Phase 2B.3.4 — Durable SaaS Renewal Cycle
// ---------------------------------------------------------------------------

model SaasRenewalCycle {
  id              String   @id @default(cuid())
  subscriptionId  String
  tenantId        String
  cycleKey        String   @unique // subscriptionId + immutable periodStart
  state           String   @default("PENDING") // PENDING | PAYMENT_PENDING | PAYMENT_CONFIRMED | FINANCIAL_POSTED | COMPLETED | PAST_DUE | RECONCILIATION_REQUIRED | FAILED
  invoiceId       String?  // linked TenantInvoice
  periodStart     DateTime // immutable — the start of the billing period being renewed
  periodEnd       DateTime // immutable — the end of the billing period being renewed
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([subscriptionId])
  @@index([tenantId])
  @@index([state])
}

// ---------------------------------------------------------------------------
// Phase 2C.1 — Connectivity Entitlement Kernel
// -----------------------------------------------------------------------------
// The connectivity entitlement layer sits between the SaaS billing kernel
// (frozen) and provider-specific adapters (MikroTik, WiFi ISP, eSIM).
//
// Three layers of truth:
//   Commercial Truth: TenantSubscription (billing kernel — FROZEN)
//   Entitlement Truth: ConnectivityEntitlement (this layer)
//   Infrastructure Truth: ProviderResourceBinding (this layer)
//
// The entitlement kernel does NOT know about MikroTik, RADIUS, eSIM suppliers,
// or ISP APIs. It only expresses what connectivity capability a customer owns.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// ConnectivityCapability — the vocabulary of grantable connectivity types.
// Provider-neutral. A capability is "what can be granted," not "how it's delivered."
// ---------------------------------------------------------------------------

model ConnectivityCapability {
  id          String   @id @default(cuid())
  type        String   @unique // INTERNET | LOCAL_NETWORK | CACHE_ACCESS | MESH_RELAY | VPN_ACCESS | ROAMING
  displayName String   // human-readable label
  description String?
  // JSON string of capability-specific attributes schema, e.g.:
  // {"downloadMbps": "number", "uploadMbps": "number", "monthlyQuotaBytes": "number"}
  attributes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entitlements ConnectivityEntitlement[]
}

// ---------------------------------------------------------------------------
// ConnectivityEntitlement — the customer's RIGHT to consume connectivity.
//
// Lifecycle: PENDING → ACTIVE → (SUSPENDED | EXPIRED | REVOKED)
//
// An entitlement is created when a subscription grants connectivity capability.
// It is separate from the subscription because:
//   - A subscription can have multiple entitlements (e.g., internet + eSIM)
//   - An entitlement can outlive a billing period (grace period)
//   - An entitlement can be suspended without cancelling the subscription
//   - Infrastructure unhealthiness does NOT affect entitlement status
// ---------------------------------------------------------------------------

model ConnectivityEntitlement {
  id              String   @id @default(cuid())
  tenantId        String
  subscriptionId  String // originating TenantSubscription
  capabilityId    String
  status          String   @default("PENDING") // PENDING | ACTIVE | SUSPENDED | EXPIRED | REVOKED
  // JSON string of the capability set granted to this entitlement, e.g.:
  // {"downloadMbps": 50, "uploadMbps": 10, "monthlyQuotaBytes": 500000000000}
  capabilitySet   String
  // JSON string of policy reference (rate limits, fair-use, priority, etc.)
  policy          String?
  validFrom       DateTime
  validUntil      DateTime?
  // Reconciliation: tracks drift between desired and observed state
  reconciliationState String? // null | RECONCILIATION_REQUIRED | RECONCILED
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capability      ConnectivityCapability @relation(fields: [capabilityId], references: [id])
  resourceBindings ProviderResourceBinding[]

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@index([capabilityId])
}

// ---------------------------------------------------------------------------
// ProviderResourceBinding — the actual external resource that delivers a capability.
//
// Lifecycle: UNBOUND → PROVISIONING → BOUND → (DEGRADED | FAILED | RELEASED)
//
// A binding is separate from the entitlement because:
//   - An ACTIVE entitlement can coexist with a FAILED binding (router offline)
//   - A binding can be rebound to a different provider without changing the entitlement
//   - The billing system does not interpret binding health as a payment problem
// ---------------------------------------------------------------------------

model ProviderResourceBinding {
  id              String   @id @default(cuid())
  entitlementId   String
  // Provider-neutral identifier: "mock" | "mikrotik" | "wifi-isp" | "esim" | future
  providerType    String
  // Phase 2C.3: Resource type within the provider (e.g., "hotspot_user", "radius_subscriber", "pppoe_session", "esim_profile")
  // Allows a single providerType to manage different kinds of resources.
  resourceType    String?
  // Provider-specific resource reference (e.g., MikroTik user profile ID, eSIM ICCID)
  // Stored as a string — the provider adapter owns the interpretation.
  providerResourceId String?
  // JSON string of provider-specific binding metadata (routerId, radiusUsername, etc.)
  // The entitlement kernel does NOT interpret these fields — they are opaque to it.
  providerMetadata String?
  status          String   @default("UNBOUND") // UNBOUND | PROVISIONING | BOUND | DEGRADED | FAILED | RELEASED
  // Provisioning is asynchronous — tracks the durable provisioning job state
  provisioningState String? // null | PENDING | IN_PROGRESS | COMPLETED | FAILED
  // Reconciliation: tracks drift between desired and observed binding state
  reconciliationState String? // null | RECONCILIATION_REQUIRED | RECONCILED | MANUAL_INTERVENTION_REQUIRED
  failureReason   String?
  lastReconciledAt DateTime?
  // Phase 2C.3.1: Provider instance — selects the specific infrastructure endpoint
  // (e.g., "accra-router-01" vs "kumasi-router-02"). providerType selects the adapter
  // CLASS; providerInstanceId selects the specific infrastructure INSTANCE.
  // Immutable after provisioning begins (PROVISIONING or later states).
  providerInstanceId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entitlement     ConnectivityEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  providerInstance ConnectivityProviderInstance? @relation(fields: [providerInstanceId], references: [id])

  @@index([entitlementId])
  @@index([providerType])
  @@index([status])
  @@index([providerInstanceId])
}

// ---------------------------------------------------------------------------
// Phase 2C.3.1 — Connectivity Provider Instance
// -----------------------------------------------------------------------------
// Represents a specific infrastructure instance (e.g., a specific MikroTik router,
// a specific eSIM supplier endpoint, a specific WiFi ISP platform).
//
// providerType selects the adapter CLASS (e.g., "mikrotik").
// providerInstance selects the specific infrastructure INSTANCE (e.g., "accra-router-01").
//
// Secrets/credentials MUST NOT be stored in plaintext. Use environment variables
// or a secrets manager referenced by configurationKey.
//
// Tenant isolation: a provider instance belongs to a tenant. Other tenants
// cannot use it.
// -----------------------------------------------------------------------------

model ConnectivityProviderInstance {
  id              String   @id @default(cuid())
  tenantId        String
  // Provider type: "mikrotik" | "wifi-isp" | "esim" | future
  providerType    String
  // Human-readable name: "Accra Router 01" | "Kumasi Router 02"
  name            String
  status          String   @default("active") // active | inactive | maintenance
  // Configuration reference — NOT secrets. E.g., endpoint URL, API version, region.
  // Secrets are resolved via environment variables or secrets manager using
  // the configurationKey as a lookup.
  configuration   String?  // JSON string of non-secret configuration
  configurationKey String? // reference to secrets manager key (e.g., "mikrotik-accra-01-creds")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resourceBindings ProviderResourceBinding[]

  @@index([tenantId])
  @@index([providerType])
  @@index([status])
}
