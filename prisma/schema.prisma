// =============================================================================
// RoamLink OS — Prisma Schema
// -----------------------------------------------------------------------------
// DATABASE (Phase 12.1 — Canonicalization):
//   Development/test environment: SQLite (sandbox constraint — no PostgreSQL
//   available in the current cloud sandbox).
//   Production target: PostgreSQL (Neon/Vercel).
//
//   The schema uses ONLY portable Prisma types (String, Int, Float, DateTime,
//   Boolean). No @db.* native types, no Json fields, no Decimal, no Bytes.
//   All JSON data is stored as String with JSON.stringify/parse. This makes the
//   schema fully portable between SQLite and PostgreSQL — switching the
//   provider for production is a one-line change.
//
//   The previous contradiction (schema declared PostgreSQL but DATABASE_URL
//   pointed to a SQLite file) caused repeated engineering friction during
//   Phase 11: Prisma client generation had to be switched between providers.
//   This is now eliminated — the provider matches the actual DATABASE_URL.
//
//   PRODUCTION DEPLOYMENT: change `provider = "sqlite"` to
//   `provider = "postgresql"` in the CI/CD pipeline before `prisma generate`.
//   The schema itself needs no other changes.
//
//   Money is stored as Int (minor units) — never float.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NOTE: Prisma requires DATABASE_URL at generate time even though it's not
// used for code generation. On Vercel, set DATABASE_URL and DIRECT_URL as
// environment variables in the project settings. If you see a build error
// like "Environment variable not found: DATABASE_URL", make sure the env
// vars are configured in Vercel → Settings → Environment Variables.

// ---------------------------------------------------------------------------
// User & Authentication
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  role          String   @default("customer") // "customer" | "admin"
  isDemo        Boolean  @default(false) // demo accounts (quick-login)
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions              Session[]
  orders                Order[]
  esims                 Esim[]
  payments              Payment[]
  topUps                TopUp[]
  // Phase 3: connectivity customer orders
  customerOrders        CustomerOrder[]
  auditLogs             AuditLog[]
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  approvedFrom          WaitlistEntry?
  approvedWaitlist      WaitlistEntry[] @relation("WaitlistApprover")
  orgMemberships        OrganizationMember[]
  virtualNumbers        VirtualNumber[]
  numberSubscriptions   NumberSubscription[]
  financialTxns         FinancialTransaction[]
  referral              Referral?             @relation("ReferralUser")
  referralUses          ReferralUse[]          @relation("RefereeUser")
  credit                CustomerCredit?
  creditTxns            CreditTransaction[]
}

model WaitlistEntry {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  status      String   @default("pending") // pending | approved | rejected
  note        String?  // admin note
  approvedById String? // admin user who approved
  approvedAt  DateTime?
  createdUserId String? @unique // the User created when approved (1:1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  approvedBy  User?    @relation("WaitlistApprover", fields: [approvedById], references: [id])
  createdUser User?    @relation(fields: [createdUserId], references: [id])

  @@index([status])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())
  // Phase 2B: active tenant context for reseller control plane.
  // Validated server-side against TenantUser membership on every request.
  activeTenantId String?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Plans (canonical marketplace model — never provider-native shape)
// ---------------------------------------------------------------------------

model Plan {
  id              String   @id @default(cuid())
  providerId      String   // internal provider key, e.g. "mock"
  providerPlanId  String   // provider's native plan id
  name            String
  description     String?
  country         String
  countryCode     String   // ISO 3166-1 alpha-2
  region          String   // e.g. "Africa", "Europe", "North America"
  dataAmount      Int      // in MB (1024 = 1 GB)
  dataUnit        String   @default("MB")
  validityDays    Int
  // Money — integer minor units (cents). See lib/money.ts.
  price           Int      // retail price in minor units
  wholesalePrice  Int      // internal cost, NEVER exposed to customers
  currency        String   @default("USD")
  coverage        String?  // comma-separated countries / description
  networks        String?  // JSON string: ["MTN","Vodafone"]
  roaming         Boolean  @default(false)
  hotspot         Boolean  @default(true)
  speed           String?  // e.g. "4G/5G"
  topUpSupported  Boolean  @default(true)
  status          String   @default("active") // "active" | "inactive"
  // Pricing rule that produced `price` (audit). JSON string.
  pricingRule     String?
  // Provider-native payload (never sent to client). JSON string.
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          Order[]

  @@unique([providerId, providerPlanId])
  @@index([countryCode])
  @@index([region])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id               String   @id @default(cuid())
  userId           String
  planId           String?  // nullable for virtual-number orders (no Plan row)
  productType      String   @default("esim") // esim | virtual_number
  // State machine: PLAN_SELECTED | CHECKOUT_CREATED | PAYMENT_PENDING |
  // PAYMENT_CONFIRMED | ESIM_PROVISIONING | ESIM_PROVISIONED | COMPLETED |
  // PAYMENT_FAILED | PROVISIONING_FAILED | CANCELLED | REFUNDED
  status           String   @default("PLAN_SELECTED")
  amount           Int      // total charged (minor units) — frozen from DistributionOffer
  currency         String   @default("USD")
  paymentStatus    String   @default("pending") // pending | succeeded | failed | refunded
  paymentProvider  String?
  paymentReference String?  // provider's payment intent / charge id
  providerOrderId  String?  // eSIM provider order id
  // Idempotency: prevents duplicate orders / payments / provisioning on retry.
  idempotencyKey   String   @unique
  // Snapshot of plan at purchase time (so historical orders stay accurate).
  planSnapshot     String?  // JSON string
  failureReason    String?
  // --- Phase 2C: Connectivity Orchestration Convergence ---
  tenantId         String?  // null = RoamLink Direct
  // Phase 2B: links the order to a reseller's customer + the distribution offer
  // that set the retail price. Both are nullable for RoamLink Direct orders.
  tenantCustomerId String?
  distributionOfferId String?
  fulfillmentStatus String  @default("pending") // pending|provisioning|success|failed|unknown|reconciliation_required
  financialStatus  String   @default("pending") // pending | settled | failed
  fulfillmentExternalReference String? // provider's external fulfillment ref
  fulfillmentEntityId String?  // id of persisted fulfillment entity (e.g. Esim.id)
  supplierOfferId  String?  // the ConnectivityOffer selected by the orchestrator
  frozenSupplierProductId String? // the supplierProductId frozen at selection time
  frozenProviderKey String? // the providerKey frozen at selection time (NOT re-read from live Supplier)
  frozenWholesalePriceMinor Int? // the wholesale price frozen at selection time (NOT re-read from live Offer)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             Plan?    @relation(fields: [planId], references: [id])
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  payments         Payment[]
  esim             Esim?
  corporateOrder   CorporateOrder?
  virtualNumber    VirtualNumber? @relation("VirtualNumberOrder")
  financialTxns    FinancialTransaction[] @relation("FinancialOrder")
  promoRedemption  PromoRedemption?       @relation("PromoOrder")

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id               String   @id @default(cuid())
  userId           String
  orderId          String
  amount           Int
  currency         String   @default("USD")
  status           String   @default("pending") // pending | succeeded | failed | refunded
  provider         String
  providerReference String?
  // Idempotency key from the client payment attempt.
  idempotencyKey   String?  @unique
  raw              String?  // provider response (server-side only), JSON string
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// eSIMs
// ---------------------------------------------------------------------------

model Esim {
  id              String    @id @default(cuid())
  userId          String
  orderId         String    @unique // one eSIM per order (1:1)
  provider        String
  providerESIMId  String?   // provider's native esim id
  iccid           String?   // 19-20 digit Integrated Circuit Card ID
  smdpAddress     String?   // SM-DP+ server address
  activationCode  String?   // LPA activation code
  matchId         String?   // optional confirmation code
  qrCode          String?   // generated QR payload (LPA string)
  status          String    @default("pending") // pending|active|expired|suspended|exhausted|cancelled
  dataAmount      Int       // total allowance in MB
  dataRemaining   Int       // remaining in MB
  validityDays    Int
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  usages          Usage[]
  topUps          TopUp[]
  orgAssignments  OrganizationESIM[]

  @@index([userId])
  @@index([status])
  @@index([iccid])
}

// ---------------------------------------------------------------------------
// Usage tracking
// ---------------------------------------------------------------------------

model Usage {
  id            String   @id @default(cuid())
  esimId        String
  dataUsed      Int      // MB used in this sample
  dataRemaining Int      // MB remaining at sample time
  source        String   @default("provider") // provider | simulated
  timestamp     DateTime @default(now())

  esim          Esim     @relation(fields: [esimId], references: [id], onDelete: Cascade)

  @@index([esimId])
}

// ---------------------------------------------------------------------------
// Top-ups
// ---------------------------------------------------------------------------

model TopUp {
  id               String   @id @default(cuid())
  esimId           String
  userId           String
  amount           Int      // charged (minor units)
  currency         String   @default("USD")
  dataAmount       Int      // MB added
  paymentStatus    String   @default("pending") // pending | succeeded | failed
  providerReference String?
  idempotencyKey   String   @unique
  createdAt        DateTime @default(now())

  esim             Esim     @relation(fields: [esimId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([esimId])
}

// ---------------------------------------------------------------------------
// Webhook events (idempotent delivery log)
// ---------------------------------------------------------------------------

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventType   String
  externalId  String?  // provider's event id, used for dedup
  payload     String   // JSON string
  processed   Boolean  @default(false)
  error       String?
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@unique([provider, externalId])
  @@index([provider, eventType])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  orderId   String?
  // Phase 2B: tenant-scoped audit trail for reseller operations.
  tenantId  String?
  action    String
  entity    String   // order | esim | payment | plan | user | tenant | tenant_customer | distribution_offer | api_key
  entityId  String?
  detail    String?  // JSON string
  ip        String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Pricing rules (markup engine)
// ---------------------------------------------------------------------------

model PricingRule {
  id         String   @id @default(cuid())
  name       String
  type       String   // "fixed" | "percentage"
  value      Int      // fixed: minor units; percentage: basis points (30% = 3000)
  scope      String   @default("global") // global | country | region
  scopeValue String?  // countryCode / region when scoped
  priority   Int      @default(0) // higher wins
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([scope, scopeValue])
}

// ---------------------------------------------------------------------------
// Notifications log (development implementation)
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  channel   String   // email | sms | push | whatsapp | log
  event     String
  recipient String?
  subject   String?
  body      String
  status    String   @default("sent") // sent | failed
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([event])
}

// ---------------------------------------------------------------------------
// Installation tokens — short-lived, secure tokens for web→mobile deep linking.
// A web purchase generates a token; the mobile app consumes it to install the
// eSIM. Never expose raw activation secrets in permanent URLs.
// ---------------------------------------------------------------------------

model InstallToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  esimId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([esimId])
}

// ---------------------------------------------------------------------------
// B2B foundation — organizations, members, corporate eSIMs.
// Built as a foundation so corporate features can be added without redesigning
// authentication. Not fully implemented yet.
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active") // active | suspended
  // Billing
  billingEmail   String?
  // Spending limits (in minor units, 0 = unlimited)
  monthlySpendLimit Int   @default(0) // 0 = no limit
  currentMonthSpend Int  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  esims     OrganizationESIM[]
  orders    CorporateOrder[]
  numbers   VirtualNumber[] @relation("OrgNumbers")
  // Phase 6: B2B employee connectivity
  employeeEntitlements EmployeeEntitlement[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member") // owner | admin | member
  // Per-member spending limit (0 = use org default, -1 = no purchases allowed)
  spendLimit     Int      @default(0) // minor units per month
  currentSpend   Int      @default(0) // spent this month
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationESIM {
  id             String   @id @default(cuid())
  organizationId String
  esimId         String
  assignedTo     String?  // employee name/email
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  esim           Esim        @relation(fields: [esimId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([esimId])
}

model CorporateOrder {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String   @unique
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Virtual Numbers — second connectivity product alongside eSIMs.
// Reuses: User, Organization, Order, Payment, WebhookEvent, AuditLog.
// ---------------------------------------------------------------------------

model VirtualNumber {
  id              String    @id @default(cuid())
  e164            String    @unique // e.g. "+233241234567"
  country         String
  countryCode     String
  region          String?
  city            String?
  numberType      String    @default("local") // local | toll_free | mobile | national
  smsEnabled      Boolean   @default(false)
  mmsEnabled      Boolean   @default(false)
  voiceEnabled    Boolean   @default(false)
  // Lifecycle: discovered | available | reserved | provisioning | configuring | active | suspended | releasing | released | failed
  status          String    @default("available")
  provider        String    // e.g. "mock", "telnyx", "twilio"
  providerNumberId String?  // provider's native number id
  providerCost    Int       // wholesale cost in minor units (monthly)
  sellingPrice    Int       // customer price in minor units (monthly)
  currency        String    @default("USD")
  userId          String?
  organizationId  String?
  orderId         String?   @unique // 1:1 with the order that purchased it
  activatedAt     DateTime?
  releasedAt      DateTime?
  expiresAt       DateTime? // subscription expiry
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  order           Order?          @relation("VirtualNumberOrder", fields: [orderId], references: [id], onDelete: SetNull)
  organization    Organization?   @relation("OrgNumbers", fields: [organizationId], references: [id], onDelete: SetNull)
  messages        Message[]
  calls           Call[]
  subscriptions   NumberSubscription[]

  @@index([userId])
  @@index([organizationId])
  @@index([countryCode])
  @@index([status])
}

model NumberSubscription {
  id              String    @id @default(cuid())
  virtualNumberId String
  userId          String
  status          String    @default("active") // active | past_due | suspended | cancelled | expired | trial | reconciliation_required
  billingCycle    String    @default("monthly") // monthly | yearly
  currentPeriodEnd DateTime
  trialEndsAt     DateTime?
  cancelledAt     DateTime?
  idempotencyKey  String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  virtualNumber   VirtualNumber @relation(fields: [virtualNumberId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  renewalCycles   SubscriptionRenewalCycle[]

  @@index([userId])
  @@index([virtualNumberId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Subscription Renewal Cycle — durable identity for each renewal attempt.
// Phase 2E.4: The renewal cycle identity is stable across retries. It does
// NOT depend on mutable currentPeriodEnd. If a renewal partially succeeds
// (financial posted, domain partially updated), the retry uses the SAME
// cycle identity — no duplicate financial transaction, no duplicate extension.
// ---------------------------------------------------------------------------

model SubscriptionRenewalCycle {
  id              String   @id @default(cuid())
  subscriptionId  String
  // The IMMUTABLE period boundaries for this renewal cycle.
  // periodStart = the currentPeriodEnd BEFORE renewal.
  // periodEnd = the target currentPeriodEnd AFTER renewal.
  periodStart     DateTime
  periodEnd       DateTime
  // The stable identity used for idempotency keys and ledger references.
  cycleKey        String   @unique // e.g. "renewal_{subId}_{periodStart.getTime()}"
  // State machine: pending → payment_confirmed → financial_posted → domain_updated → completed
  //                pending → failed
  //                financial_posted → reconciliation_required (if domain update fails)
  state           String   @default("pending") // pending | payment_confirmed | financial_posted | domain_updated | completed | reconciliation_required | failed
  // Financial tracking
  paidFromCreditMinor Int  @default(0)
  paidFromCashMinor    Int  @default(0)
  paymentFeeMinor      Int  @default(0)
  // Error tracking for retries
  lastError       String?
  retryCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscription    NumberSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([state])
  @@index([periodStart])
}

model Message {
  id              String   @id @default(cuid())
  virtualNumberId String
  direction       String   // inbound | outbound
  fromNumber      String
  toNumber        String
  body            String
  status          String   @default("received") // received | sent | delivered | failed
  providerMessageId String?
  segments        Int      @default(1)
  createdAt       DateTime @default(now())

  virtualNumber   VirtualNumber @relation(fields: [virtualNumberId], references: [id], onDelete: Cascade)

  @@index([virtualNumberId])
  @@index([createdAt])
}

model Call {
  id              String   @id @default(cuid())
  virtualNumberId String
  direction       String   // inbound | outbound
  fromNumber      String
  toNumber        String
  status          String   @default("completed") // ringing | in_progress | completed | failed | no_answer | busy
  durationSeconds Int      @default(0)
  providerCallId  String?
  recordingUrl    String?
  createdAt       DateTime @default(now())

  virtualNumber   VirtualNumber @relation(fields: [virtualNumberId], references: [id], onDelete: Cascade)

  @@index([virtualNumberId])
  @@index([createdAt])
}

model TrialPolicy {
  id              String   @id @default(cuid())
  name            String   @unique
  durationHours   Int      @default(24)
  maxNumbers      Int      @default(1)
  maxInboundSMS   Int      @default(3)
  maxOutboundSMS  Int      @default(0)
  maxInboundMinutes Int    @default(5)
  maxOutboundMinutes Int   @default(0)
  apiAllowed      Boolean  @default(false)
  eligibleCountries String? // comma-separated country codes, null = all
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CountryCapability {
  id              String   @id @default(cuid())
  countryCode     String   @unique
  country         String
  smsAllowed      Boolean  @default(true)
  voiceAllowed    Boolean  @default(true)
  mmsAllowed      Boolean  @default(false)
  identityRequired Boolean @default(false)
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Financial Ledger — immutable record of all financial events.
// Financial truth must not depend exclusively on mutable order records.
// ---------------------------------------------------------------------------

model FinancialTransaction {
  id              String   @id @default(cuid())
  type            String   // CUSTOMER_PAYMENT | PAYMENT_FEE | PROVIDER_PURCHASE | PROVIDER_LIABILITY | PROVIDER_INVOICE | PROVIDER_PAYMENT | REFUND | CHARGEBACK | PROMOTIONAL_CREDIT | CUSTOMER_CREDIT | TRIAL_COST | COMMISSION | ADJUSTMENT
  userId          String?
  organizationId  String?
  orderId         String?
  provider        String?  // esim provider or payment provider
  providerTxnId   String?  // provider's transaction id
  amountMinor     Int      // positive = debit (cost), negative = credit (revenue). In minor units.
  currency        String   @default("USD")
  // Financial breakdown (all in minor units, may be 0 if not applicable)
  customerPrice   Int      @default(0)  // what customer paid
  providerCost    Int      @default(0)  // wholesale cost
  paymentFee      Int      @default(0)  // payment processing fee
  grossProfit     Int      @default(0)  // customerPrice - providerCost
  contributionProfit Int   @default(0)  // grossProfit - paymentFee - refundCost - fraudLoss
  refundCost      Int      @default(0)
  fraudLoss       Int      @default(0)
  // Metadata
  source          String   @default("system") // system | admin | provider | webhook
  reason          String?
  state           String   @default("pending") // pending | settled | disputed | reversed
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())
  settledAt       DateTime?

  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  order           Order?         @relation("FinancialOrder", fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Provider Credit Account — tracks provider credit facilities (e.g., Airalo $10K).
// This is a financial liability, NOT cash. Must be tracked for risk control.
// ---------------------------------------------------------------------------

model ProviderCreditAccount {
  id              String   @id @default(cuid())
  provider        String   @unique // e.g. "airalo", "mock"
  creditLimit     Int      // in minor units (e.g., 1000000 = $10,000)
  currency        String   @default("USD")
  outstandingLiability Int  @default(0) // accumulated unbilled provider purchases
  pendingCommitments Int   @default(0) // in-flight provider orders not yet confirmed
  invoicedAmount  Int      @default(0) // amount invoiced by provider
  paidAmount      Int      @default(0) // amount paid to provider
  // Thresholds (percentage of credit limit)
  thresholdInfo   Int      @default(50) // informational
  thresholdWarn   Int      @default(75) // warning
  thresholdElevated Int    @default(80) // elevated
  thresholdCritical Int    @default(90) // critical — restrict new commitments
  thresholdEmergency Int   @default(95) // emergency
  // State
  active          Boolean  @default(true)
  lastInvoiceDate DateTime?
  nextPaymentDue  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoices        ProviderInvoice[]
}

model ProviderInvoice {
  id              String   @id @default(cuid())
  providerAccountId String
  providerInvoiceId String? @unique // provider's invoice number
  amountMinor     Int      // invoiced amount in minor units
  currency        String   @default("USD")
  status          String   @default("pending") // pending | paid | overdue | disputed
  periodStart     DateTime?
  periodEnd       DateTime?
  dueDate         DateTime?
  paidAt          DateTime?
  // Reconciliation
  reconciledTransactions Int @default(0)
  mismatchedTransactions  Int @default(0)
  reconciled      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  providerAccount ProviderCreditAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)

  @@index([providerAccountId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Pricing Snapshot — preserves the pricing used for each transaction so
// historical economics can't be retroactively changed.
// ---------------------------------------------------------------------------

model PricingSnapshot {
  id              String   @id @default(cuid())
  orderId         String?  @unique
  productId       String?  // planId or virtualNumberId
  productType     String   // esim | virtual_number
  wholesaleMinor  Int      // provider cost at time of purchase
  retailMinor     Int      // customer price at time of purchase
  currency        String   @default("USD")
  markupPercent   Float    // (retail - wholesale) / wholesale * 100
  grossMarginPercent Float // (retail - wholesale) / retail * 100
  pricingRule     String?  // JSON of the rule that produced this price
  createdAt       DateTime @default(now())

  @@index([productType])
}

// ---------------------------------------------------------------------------
// Promo Codes — promotional discounts at checkout.
// ---------------------------------------------------------------------------

model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. "TRAVEL20"
  description     String?
  type            String   // "percentage" | "fixed"
  value           Int      // percentage: 20 = 20% off; fixed: 500 = $5.00 off (minor units)
  currency        String   @default("USD")
  minOrderAmount  Int      @default(0) // minimum order amount in minor units (0 = no minimum)
  maxDiscount     Int?     // cap on discount amount (minor units, null = no cap)
  maxUses         Int?     // null = unlimited
  maxUsesPerUser  Int      @default(1)
  usesCount       Int      @default(0)
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  active          Boolean  @default(true)
  // Profitability guardrail
  minMarginPercent Float?  // reject if discount would push margin below this
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions     PromoRedemption[]

  @@index([active])
}

model PromoRedemption {
  id              String   @id @default(cuid())
  promoCodeId     String
  orderId         String   @unique
  userId          String
  discountAmount  Int      // actual discount applied (minor units)
  currency        String   @default("USD")
  createdAt       DateTime @default(now())

  promoCode       PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  order           Order     @relation("PromoOrder", fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([promoCodeId])
}

// ---------------------------------------------------------------------------
// Referrals — customer referral codes + credit rewards.
// ---------------------------------------------------------------------------

model Referral {
  id              String   @id @default(cuid())
  referrerUserId  String   @unique // each user has one referral code
  referralCode    String   @unique // e.g. "ROAM-ABC123"
  // Reward config (in minor units)
  referrerReward  Int      @default(200) // $2.00 credit for referrer
  refereeReward   Int      @default(200) // $2.00 credit for referee
  currency        String   @default("USD")
  // Stats
  totalReferrals  Int      @default(0)
  completedReferrals Int   @default(0) // referee made a purchase
  totalRewardPaid Int      @default(0)
  createdAt       DateTime @default(now())

  referrer        User     @relation("ReferralUser", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referrals       ReferralUse[]

  @@index([referrerUserId])
}

model ReferralUse {
  id              String   @id @default(cuid())
  referralId      String
  refereeUserId   String
  orderId         String?  // first purchase that completed the referral
  status          String   @default("pending") // pending | completed | rejected
  referrerCredited Boolean @default(false)
  refereeCredited Boolean @default(false)
  createdAt       DateTime @default(now())

  referral        Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referee         User     @relation("RefereeUser", fields: [refereeUserId], references: [id], onDelete: Cascade)

  @@unique([referralId, refereeUserId])
  @@index([refereeUserId])
}

// ---------------------------------------------------------------------------
// Customer Credit / Wallet — unified balance across products.
// ---------------------------------------------------------------------------

model CustomerCredit {
  id              String   @id @default(cuid())
  userId          String   @unique
  balanceMinor    Int      @default(0) // current balance in minor units
  currency        String   @default("USD")
  totalEarned     Int      @default(0) // lifetime credits earned
  totalSpent      Int      @default(0) // lifetime credits spent
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    CreditTransaction[]

  @@index([userId])
}

model CreditTransaction {
  id              String   @id @default(cuid())
  creditId        String
  userId          String
  type            String   // referral_reward | promo_credit | admin_adjustment | purchase_credit | refund_credit
  amountMinor     Int      // positive = credit added, negative = credit spent
  balanceAfter    Int      // balance after this transaction
  reason          String?
  orderId         String?
  referrerId      String?
  createdAt       DateTime @default(now())

  credit          CustomerCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phase 2E.7: Unique constraint for spend idempotency.
  // For spending (type = "purchase_credit"), (userId, orderId, type) must be unique.
  // For issuance, the CreditIssuance model provides the idempotency identity.
  // This constraint prevents duplicate spending for the same business event.
  @@unique([userId, orderId, type])
  @@index([userId])
  @@index([creditId])
}

// ---------------------------------------------------------------------------
// Credit Issuance — durable, idempotent credit issuance lifecycle.
// Phase 2E.7: Ensures credit issuance cannot silently diverge from the ledger.
// The issuance has a stable identity, a state machine, and tracks both the
// operational credit transaction and the financial ledger transaction.
// ---------------------------------------------------------------------------

model CreditIssuance {
  id                  String   @id @default(cuid())
  userId              String
  amountMinor         Int
  sourceType          String   // referral_reward | promo_credit | admin_adjustment | refund_credit
  sourceId            String   // referralUseId | promoCodeId | adminOperationId | refundId
  idempotencyKey      String   @unique // stable business identity
  status              String   @default("pending") // pending | posted | completed | reconciliation_required
  creditTransactionId String?
  ledgerTransactionId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([sourceType, sourceId])
  @@index([status])
}

// ===========================================================================
// Phase 2C — Connectivity Orchestration Convergence
// ===========================================================================
// These models make Tenant, DistributionOffer, canonical product identity,
// and the orchestration engine load-bearing in the real purchase path.
//
//   Plan (legacy provider-native catalog)
//     → ConnectivityProduct (canonical, identity-hashed)
//       → ConnectivityOffer (per-Supplier wholesale price)
//       → DistributionOffer (per-Tenant retail price — what the customer pays)
//     → Order (captures canonicalProductId + distributionOfferId at checkout)
//       → Orchestrator selects a ConnectivityOffer at fulfillment time
//       → FulfillmentAdapter provisions the product
//       → FulfillmentPersistenceHandler stores the entity (Esim, etc.)
//       → Double-entry ledger records the commercial transaction
// ===========================================================================

model ConnectivityProduct {
  id              String   @id @default(cuid())
  type            String   // ESIM | VIRTUAL_NUMBER | WIFI | LOCAL_DATA | BUNDLE
  name            String
  description     String?
  country         String?
  countryCode     String?
  region          String?
  dataAmountMB    Int?
  validityDays    Int?
  capabilities    String?
  sourcePlanId    String?  @unique
  canonicalSpecification String?
  identityHash    String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  offers          ConnectivityOffer[]
  distributionOffers DistributionOffer[]

  @@index([type])
  @@index([identityHash])
}

model Supplier {
  id              String   @id @default(cuid())
  name            String   @unique
  type            String
  providerKey     String?
  redistributionPolicy String @default("B2C_ONLY")
  supportedCapabilities String?
  healthStatus    String   @default("healthy")
  failureCount    Int      @default(0)
  successCount    Int      @default(0)
  lastFailureAt   DateTime?
  lastSuccessAt   DateTime?
  cooldownUntil   DateTime?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  offers          ConnectivityOffer[]
}

model ConnectivityOffer {
  id              String   @id @default(cuid())
  productId       String
  supplierId      String
  wholesalePrice  Int
  retailPrice     Int
  currency        String   @default("USD")
  status          String   @default("active")
  audiences       String   @default("B2C")
  availableIn     String?
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  supplierProductId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         ConnectivityProduct @relation(fields: [productId], references: [id])
  supplier        Supplier            @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([supplierId])
}

model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  status          String   @default("active")
  brandName       String?
  brandColor      String?
  customDomain    String?  @unique
  billingEmail    String?
  monthlySpendLimit Int    @default(0)
  defaultMarkupPercent Float @default(0)
  apiKey          String?  @unique
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  distributionOffers DistributionOffer[]
  orders          Order[]
  users           TenantUser[]
  // Phase 2B: reseller control plane relations
  customers       TenantCustomer[]
  subscription    TenantSubscription?
  apiKeys         ApiKey[]
  // Phase 2B.1: reseller balance + transactions
  balance         TenantBalance?
  transactions    TenantTransaction[]
  // Phase 2B.2: reservations + deposit payments
  reservations    TenantBalanceReservation[]
  depositPayments TenantDepositPayment[]
  // Phase 2B.3: SaaS invoices
  invoices        TenantInvoice[]
  // Phase 2C.1: connectivity entitlements
  entitlements    ConnectivityEntitlement[]
  // Phase 2C.3.1: connectivity provider instances
  providerInstances ConnectivityProviderInstance[]
  // Phase 3: commercial catalog + orders
  resellerProducts ResellerProduct[]
  customerOrders  CustomerOrder[]
  // Phase 4: normalized offers + markup rules + customer intents
  connectivityOffers ConnectivityOffer2[]
  resellerMarkups  ResellerMarkup[]
  connectivityIntents ConnectivityIntent[]
  // Phase 6: reseller economics + marketplace intelligence
  resellerEarnings ResellerEarning[]
  providerCosts   ProviderCost[]
  payouts         ResellerPayout[]
  intentRequests  IntentRequest[]
  // Phase 7: settlement + trust signals
  supplierSettlements SupplierSettlement[]
  offerRatings    OfferRating[]
  uptimeMeasurements UptimeMeasurement[]

  @@index([status])
}

model TenantUser {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  // Phase 2B: full reseller role set.
  // owner | admin | sales | support | billing | operations | viewer
  role            String   @default("admin")
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model DistributionOffer {
  id              String   @id @default(cuid())
  productId       String
  tenantId        String?  // null = RoamLink Direct
  retailPrice     Int
  currency        String   @default("USD")
  markupPercent   Float    @default(0)
  status          String   @default("active")
  audience        String   @default("B2C")
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         ConnectivityProduct @relation(fields: [productId], references: [id])
  tenant          Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([productId, tenantId])
  @@index([productId])
  @@index([tenantId])
}

model ProviderCreditReservation {
  id              String   @id @default(cuid())
  reservationId   String   @unique
  provider        String
  amountMinor     Int
  status          String   @default("reserved") // reserved | settled | released
  orderId         String?
  createdAt       DateTime @default(now())
  settledAt       DateTime?
  releasedAt      DateTime?

  @@index([provider, status])
}

model LedgerAccount {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  type            String
  normalBalance   String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  entries         LedgerEntry[]
}

model LedgerTransaction {
  id              String   @id @default(cuid())
  reference       String?
  type            String
  description     String?
  currency        String   @default("USD")
  status          String   @default("posted")
  idempotencyKey  String?  @unique
  userId          String?
  organizationId  String?
  orderId         String?
  provider        String?
  providerTxnId   String?
  createdAt       DateTime @default(now())
  postedAt        DateTime?
  entries         LedgerEntry[]

  @@index([orderId])
  @@index([type])
}

model LedgerEntry {
  id              String   @id @default(cuid())
  transactionId   String
  accountId       String
  direction       String
  amountMinor     Int
  currency        String   @default("USD")
  createdAt       DateTime @default(now())
  transaction     LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account         LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([transactionId])
}

// ===========================================================================
// Phase 2B — Reseller SaaS Control Plane
// ===========================================================================
// These models sit ON TOP OF the canonical connectivity platform. They do NOT
// replace Order, Ledger, ConnectivityProduct, or any existing primitive.
// A reseller (Tenant) operates their business through these models, which
// resolve down to the existing orchestration/fulfillment/ledger pipeline.
// ===========================================================================

// ---------------------------------------------------------------------------
// Tenant Customer — a reseller's customer (distinct from a RoamLink User).
// A TenantCustomer MAY have a linked RoamLink User account (for self-service),
// but can also exist as a reseller-managed record with no user account.
// A global RoamLink user may belong to multiple tenants' customer lists.
// ---------------------------------------------------------------------------

model TenantCustomer {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?  // optional link to a RoamLink User account
  name        String
  email       String
  phone       String?
  status      String   @default("active") // active | suspended | cancelled
  metadata    String?  // JSON string for extensible fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// SaaS Plan — configurable subscription tiers for resellers.
// ---------------------------------------------------------------------------

model SaaasPlan {
  id              String   @id @default(cuid())
  name            String   @unique // free | starter | business | enterprise
  displayName     String
  monthlyPriceMinor Int
  currency        String   @default("USD")
  includedStaff   Int      @default(1)
  includedCustomers Int    @default(10)
  includedOrdersPerMonth Int @default(100)
  platformFeePercent Float @default(0) // percentage of transaction taken as platform fee
  perOrderFeeMinor Int     @default(0) // flat fee per order in minor units
  features        String?  // JSON string of feature flags
  status          String   @default("active") // active | deprecated
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   TenantSubscription[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Tenant Subscription — a tenant's active SaaS subscription.
// Uses the same durable renewal-cycle machinery as connectivity subscriptions.
// ---------------------------------------------------------------------------

model TenantSubscription {
  id              String   @id @default(cuid())
  tenantId        String   @unique // one active subscription per tenant
  saaasPlanId     String
  status          String   @default("active") // active | past_due | cancelled | expired | trialing
  billingCycle    String   @default("monthly") // monthly | yearly
  currentPeriodEnd DateTime
  // Phase 2B.3: Payment lifecycle fields
  paymentProvider String?  // mock | stripe | paystack | flutterwave
  providerReference String? // provider's subscription/payment reference
  // Durable renewal identity (like SubscriptionRenewalCycle for connectivity)
  // Prevents duplicate renewal charges across retries
  renewalIdempotencyKey String?
  cancelledAt     DateTime?
  cancelReason    String?
  trialEndsAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saaasPlan       SaaasPlan @relation(fields: [saaasPlanId], references: [id])
  invoices        TenantInvoice[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 2B.3 — SaaS Invoice (receipt record for each subscription payment)
// ---------------------------------------------------------------------------

model TenantInvoice {
  id              String   @id @default(cuid())
  tenantId        String
  subscriptionId  String
  saaasPlanName   String   // snapshot of plan name at billing time
  amountMinor     Int
  currency        String   @default("USD")
  billingCycle    String   // monthly | yearly
  // Phase 2B.3.4: Nullable for unpaid invoices — no fake billing period.
  // Set to actual payment-time period when the invoice is paid.
  periodStart     DateTime?
  periodEnd       DateTime?
  status          String   @default("pending") // pending | paid | failed | refunded | reconciliation_required
  paymentProvider String?  // mock | stripe | paystack | flutterwave
  providerReference String? // provider's payment intent/charge reference
  ledgerTransactionId String?
  paidAt          DateTime?
  failureReason   String?
  idempotencyKey  String   @unique // durable identity (prevents duplicate invoices)
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription    TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// API Key — tenant-scoped API keys for programmatic access.
// ---------------------------------------------------------------------------

model ApiKey {
  id          String   @id @default(cuid())
  tenantId    String
  name        String   // human-readable label
  hashedKey   String   @unique // bcrypt or sha256 hash of the raw key
  prefix      String   // first 8 chars shown in lists for identification
  scopes      String   @default("read") // JSON array: ["read","write","orders","customers"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdBy   String   // userId
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([hashedKey])
}

// ---------------------------------------------------------------------------
// Phase 12.3.2 — IdempotencyOperation — DB-authoritative "run once" primitive.
//
// The prior runIdempotent() helper had a classic read-then-write race:
//   A: findExisting → null
//   B: findExisting → null
//   A: execute  (creates side effect #1)
//   B: execute  (creates side effect #2 — duplicate payment/order/provision)
//
// The DB unique constraints on Order/Payment/TopUp.idempotencyKey caught the
// duplicate INSERT, but the second request received a raw P2002 unique-constraint
// violation surfaced as an unhandled 500 — NOT a clean replay of the first result.
//
// This model makes the INSERT itself the atomic claim. A concurrent request that
// loses the claim race receives a P2002, polls for the claim to reach a terminal
// state (COMPLETED | FAILED), and returns the stored result (replay) or the
// failure (dead-letter). There is no read-then-write window.
//
// State machine:
//   IN_PROGRESS → COMPLETED  (execute succeeded; resultJson stored)
//   IN_PROGRESS → FAILED     (execute threw; error stored, retriable via new key)
//
// The (scope, key) pair is globally unique — the caller must namespace the key
// (e.g. "checkout:user_X:abc123"). The tenantId + principalId are recorded for
// audit but are NOT part of the uniqueness key (the caller's scope already
// encodes the authority boundary).
// ---------------------------------------------------------------------------

model IdempotencyOperation {
  id              String   @id @default(cuid())
  // Logical namespace for the key, e.g. "checkout", "payment", "topup", "provision".
  scope           String
  // The idempotency key supplied by the client (or generated). Unique within (scope, key).
  key             String
  // State machine (Phase 12.3.2.3 — crash-after-side-effect + reconciliation ownership):
  //   IN_PROGRESS             — claimed, execute() is running (heartbeat active).
  //   COMPLETED               — execute() succeeded or reconciliation confirmed SUCCESS.
  //                             Result stored. Safe to replay.
  //   FAILED                  — execute() threw a CONFIRMED failure (provider explicitly
  //                             rejected, validation error). Safe to retry with a new key.
  //   RECONCILIATION_REQUIRED — the worker crashed, the lease expired, OR execute()
  //                             threw an AMBIGUOUS external error (timeout, connection
  //                             reset). The external side effect's outcome is UNKNOWN.
  //                             The caller MUST NOT retry with a new key. A reconciliation
  //                             worker must query the provider with the same providerKey.
  //   RECONCILIATION_CLAIMED  — a reconciliation worker has claimed the operation and is
  //                             querying the provider. Prevents concurrent reconciliation.
  //
  // Phase 12.3.2.3: Only provider-confirmed negative outcomes may become FAILED.
  // Ambiguous external errors (timeout, ECONNRESET, lost response) become
  // RECONCILIATION_REQUIRED — the outcome is unknown, not failed.
  //
  // The distinction between FAILED and RECONCILIATION_REQUIRED is the core of
  // Phase 12.3.2.2: "retryable failure" vs "unknown outcome requiring reconciliation".
  state           String   @default("IN_PROGRESS")
  // The operation's result (JSON-serialized). Present when state = COMPLETED.
  resultJson      String?
  // The operation's failure (JSON-serialized { errorClass, message, statusCode }).
  // Present when state = FAILED or RECONCILIATION_REQUIRED.
  failureJson     String?
  // A SHA-256 hash of the request payload, for conflict detection. If two
  // requests use the same key but different payloads, the second is rejected
  // with 409 Conflict (idempotency key reuse with conflicting payload).
  payloadHash     String?
  // Audit: who claimed this operation.
  tenantId        String?
  principalId     String?  // user.id or api_key.id
  principalType   String?  // "session" | "api_key"
  // Phase 12.3.2.1: Fenced ownership token. Generated when the claim is
  // acquired. All lease renewals and terminal-state transitions use a
  // conditional WHERE clause on claimId — only the claim owner can renew
  // or complete. A stale owner (whose claim was reclaimed after genuine
  // lease expiry) cannot extend the lease or store a result.
  claimId         String?
  // Lease: when this claim expires if still IN_PROGRESS (crashed worker recovery).
  // The heartbeat renews this while execute() runs. A reclaim worker can only
  // transition to RECONCILIATION_REQUIRED when this has genuinely expired AND
  // the owner is not actively renewing it (the fenced renewal uses claimId).
  claimExpiresAt  DateTime?
  // Phase 12.3.2.2: The provider-side idempotency key. When execute() performs
  // an external side effect (payment, provisioning, topup), the caller MUST
  // pass this key to the provider so the provider deduplicates on it. If the
  // worker crashes after the provider accepted the request, the reconciliation
  // worker queries the provider with THIS key to determine the actual outcome.
  // If null, the operation has no external side effect (or the caller did not
  // supply one) and RECONCILIATION_REQUIRED is terminal (no reconciliation possible).
  providerKey     String?
  // Phase 12.3.2.2: When the reconciliation worker last queried the provider.
  // Used to avoid hammering the provider on repeated reconciliation cycles.
  reconciledAt    DateTime?
  // Phase 12.3.2.3: Reconciliation claim ownership. When a reconciliation worker
  // begins querying the provider, it claims the operation with a fenced UPDATE:
  //   WHERE state = RECONCILIATION_REQUIRED → state = RECONCILIATION_CLAIMED
  // This prevents two reconciliation workers from both querying the provider
  // concurrently (which may have side effects, consume rate limits, or return
  // inconsistent snapshots). The claim has a lease; a crashed reconciliation
  // worker's claim is reclaimable after expiry.
  reconciliationClaimId        String?
  reconciliationClaimExpiresAt DateTime?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@unique([scope, key])
  @@index([state])
  @@index([claimExpiresAt])
  @@index([tenantId])
  @@index([claimId])
  @@index([providerKey])
  @@index([reconciledAt])
}

// ---------------------------------------------------------------------------
// Phase 2B.1 — Reseller Balance & Transactions
// ---------------------------------------------------------------------------

model TenantBalance {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  balanceMinor    Int      @default(0) // current prepaid balance in minor units
  currency        String   @default("USD")
  totalDepositedMinor Int  @default(0) // lifetime deposits
  totalSpentMinor Int      @default(0) // lifetime connectivity purchases
  // Phase 2B.2.7: Per-tenant monotonic sequence counter for TenantTransaction.
  // This is the authoritative sequence allocator — every TenantTransaction
  // creation locks this row (FOR UPDATE), reads nextTransactionSequence,
  // assigns it, and increments it. This prevents the MAX+1 race condition.
  nextTransactionSequence Int @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TenantTransaction {
  id              String   @id @default(cuid())
  tenantId        String
  type            String   // deposit | purchase | reservation | release | saas_payment | refund | adjustment
  amountMinor     Int      // positive = credit added, negative = debit
  balanceAfter    Int      // balance after this transaction
  orderId         String?  // linked order (for purchases)
  ledgerTransactionId String? // linked ledger transaction
  description     String?
  idempotencyKey  String   @unique // durable identity (prevents duplicate deposits/purchases)
  // Phase 2B.2.6: Per-tenant monotonic sequence number for deterministic
  // chronological ordering. Unlike createdAt (which can collide under concurrent
  // transactions), sequenceNumber provides a durable total order for financial
  // history reconstruction.
  sequenceNumber  Int
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sequenceNumber])
  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Phase 2B.2 — Reseller Balance Reservation + Deposit Payment Lifecycle
// ---------------------------------------------------------------------------

model TenantBalanceReservation {
  id              String   @id @default(cuid())
  tenantId        String
  orderId         String   @unique // one reservation per order
  amountMinor     Int      // reserved amount (retail price)
  platformFeeMinor Int     // platform fee at reservation time
  state           String   @default("RESERVED") // RESERVED | SETTLED | RELEASED | RECONCILIATION_REQUIRED
  idempotencyKey  String   @unique // durable identity
  ledgerTransactionId String? // ledger posting (set on SETTLE)
  releasedAt      DateTime?
  settledAt       DateTime?
  failureReason   String?
  // Phase 2B.2.3: Why the reservation is in RECONCILIATION_REQUIRED.
  // LEDGER_POSTING_FAILED | FULFILLMENT_UNKNOWN | TENANT_TRANSACTION_FAILED | OTHER
  // This distinguishes "ledger failed after successful fulfillment" (safe to retry settlement)
  // from "fulfillment state unknown" (must NOT settle until fulfillment is confirmed).
  reconciliationReason String?
  // Phase 2B.2.5: Marks whether the operational projection (TenantTransaction)
  // has been confirmed to exist. When false, the reconciliation worker should
  // check/repair it. When true, the worker skips it (scalability optimization).
  projectionReconciled Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([state])
  @@index([orderId])
}

model TenantDepositPayment {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String
  amountMinor     Int
  currency        String   @default("USD")
  paymentProvider String   // mock | paystack | flutterwave | stripe
  providerReference String? // provider's payment intent/charge reference
  status          String   @default("DEPOSIT_CREATED") // DEPOSIT_CREATED | PAYMENT_PENDING | PAYMENT_SUCCEEDED | PAYMENT_FAILED | BALANCE_POSTED | COMPLETED | CANCELLED | RECONCILIATION_REQUIRED
  idempotencyKey  String   @unique // durable identity for the deposit operation
  tenantTransactionId String? // linked TenantTransaction (set when balance is credited)
  ledgerTransactionId String? // linked ledger transaction
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([providerReference])
}

// ---------------------------------------------------------------------------
// Phase 2B.3.4 — Durable SaaS Renewal Cycle
// ---------------------------------------------------------------------------

model SaasRenewalCycle {
  id              String   @id @default(cuid())
  subscriptionId  String
  tenantId        String
  cycleKey        String   @unique // subscriptionId + immutable periodStart
  state           String   @default("PENDING") // PENDING | PAYMENT_PENDING | PAYMENT_CONFIRMED | FINANCIAL_POSTED | COMPLETED | PAST_DUE | RECONCILIATION_REQUIRED | FAILED
  invoiceId       String?  // linked TenantInvoice
  periodStart     DateTime // immutable — the start of the billing period being renewed
  periodEnd       DateTime // immutable — the end of the billing period being renewed
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([subscriptionId])
  @@index([tenantId])
  @@index([state])
}

// ---------------------------------------------------------------------------
// Phase 2C.1 — Connectivity Entitlement Kernel
// -----------------------------------------------------------------------------
// The connectivity entitlement layer sits between the SaaS billing kernel
// (frozen) and provider-specific adapters (MikroTik, WiFi ISP, eSIM).
//
// Three layers of truth:
//   Commercial Truth: TenantSubscription (billing kernel — FROZEN)
//   Entitlement Truth: ConnectivityEntitlement (this layer)
//   Infrastructure Truth: ProviderResourceBinding (this layer)
//
// The entitlement kernel does NOT know about MikroTik, RADIUS, eSIM suppliers,
// or ISP APIs. It only expresses what connectivity capability a customer owns.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// ConnectivityCapability — the vocabulary of grantable connectivity types.
// Provider-neutral. A capability is "what can be granted," not "how it's delivered."
// ---------------------------------------------------------------------------

model ConnectivityCapability {
  id          String   @id @default(cuid())
  type        String   @unique // INTERNET | LOCAL_NETWORK | CACHE_ACCESS | MESH_RELAY | VPN_ACCESS | ROAMING
  displayName String   // human-readable label
  description String?
  // JSON string of capability-specific attributes schema, e.g.:
  // {"downloadMbps": "number", "uploadMbps": "number", "monthlyQuotaBytes": "number"}
  attributes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entitlements ConnectivityEntitlement[]
}

// ---------------------------------------------------------------------------
// ConnectivityEntitlement — the customer's RIGHT to consume connectivity.
//
// Lifecycle: PENDING → ACTIVE → (SUSPENDED | EXPIRED | REVOKED)
//
// An entitlement is created when a subscription grants connectivity capability.
// It is separate from the subscription because:
//   - A subscription can have multiple entitlements (e.g., internet + eSIM)
//   - An entitlement can outlive a billing period (grace period)
//   - An entitlement can be suspended without cancelling the subscription
//   - Infrastructure unhealthiness does NOT affect entitlement status
// ---------------------------------------------------------------------------

model ConnectivityEntitlement {
  id              String   @id @default(cuid())
  tenantId        String
  subscriptionId  String // originating TenantSubscription
  capabilityId    String
  status          String   @default("PENDING") // PENDING | ACTIVE | SUSPENDED | EXPIRED | REVOKED
  // JSON string of the capability set granted to this entitlement, e.g.:
  // {"downloadMbps": 50, "uploadMbps": 10, "monthlyQuotaBytes": 500000000000}
  capabilitySet   String
  // JSON string of policy reference (rate limits, fair-use, priority, etc.)
  policy          String?
  validFrom       DateTime
  validUntil      DateTime?
  // Reconciliation: tracks drift between desired and observed state
  reconciliationState String? // null | RECONCILIATION_REQUIRED | RECONCILED
  failureReason   String?
  // Phase 8.6: Schema drift correction. The control-plane kernel-bridge and
  // invariant-checker query entitlement.userId to scope entitlements to a
  // subject (user). The frozen kernel (entitlement.ts) does not write this
  // field — it passes userId only to the audit log — so kernel-created
  // entitlements remain NULL here. User-scoped flows and test fixtures set it.
  // This column is additive (nullable) and unblocks the runtime control loop.
  userId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capability      ConnectivityCapability @relation(fields: [capabilityId], references: [id])
  resourceBindings ProviderResourceBinding[]
  // Phase 12.2 P0-5: Sessions are linked to a tenant via their entitlement.
  // This relation allows the sessions GET route to filter by tenant at the
  // database query level (entitlement: { tenantId, userId }) BEFORE take/limit,
  // rather than fetching take rows and filtering in application code.
  sessions        ConnectivitySession[]

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@index([capabilityId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// ProviderResourceBinding — the actual external resource that delivers a capability.
//
// Lifecycle: UNBOUND → PROVISIONING → BOUND → (DEGRADED | FAILED | RELEASED)
//
// A binding is separate from the entitlement because:
//   - An ACTIVE entitlement can coexist with a FAILED binding (router offline)
//   - A binding can be rebound to a different provider without changing the entitlement
//   - The billing system does not interpret binding health as a payment problem
// ---------------------------------------------------------------------------

model ProviderResourceBinding {
  id              String   @id @default(cuid())
  entitlementId   String
  // Provider-neutral identifier: "mock" | "mikrotik" | "wifi-isp" | "esim" | future
  providerType    String
  // Phase 2C.3: Resource type within the provider (e.g., "hotspot_user", "radius_subscriber", "pppoe_session", "esim_profile")
  // Allows a single providerType to manage different kinds of resources.
  resourceType    String?
  // Provider-specific resource reference (e.g., MikroTik user profile ID, eSIM ICCID)
  // Stored as a string — the provider adapter owns the interpretation.
  providerResourceId String?
  // JSON string of provider-specific binding metadata (routerId, radiusUsername, etc.)
  // The entitlement kernel does NOT interpret these fields — they are opaque to it.
  providerMetadata String?
  status          String   @default("UNBOUND") // UNBOUND | PROVISIONING | BOUND | DEGRADED | FAILED | RELEASED
  // Provisioning is asynchronous — tracks the durable provisioning job state
  provisioningState String? // null | PENDING | IN_PROGRESS | COMPLETED | FAILED
  // Reconciliation: tracks drift between desired and observed binding state
  reconciliationState String? // null | RECONCILIATION_REQUIRED | RECONCILED | MANUAL_INTERVENTION_REQUIRED
  failureReason   String?
  lastReconciledAt DateTime?
  // Phase 2C.3.1: Provider instance — selects the specific infrastructure endpoint
  // (e.g., "accra-router-01" vs "kumasi-router-02"). providerType selects the adapter
  // CLASS; providerInstanceId selects the specific infrastructure INSTANCE.
  // Immutable after provisioning begins (PROVISIONING or later states).
  providerInstanceId String?
  // Phase 2C.4.5: Durable provisioning claim identity + lease.
  // Only the worker holding provisioningAttemptId may execute provider operations
  // or finalize the binding. A stale worker (whose attemptId no longer matches)
  // cannot mutate the binding.
  provisioningAttemptId String?
  // Phase 2C.4.5: When the current provisioning claim expires.
  // After this time, another worker may atomically take over the claim.
  claimExpiresAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entitlement     ConnectivityEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  providerInstance ConnectivityProviderInstance? @relation(fields: [providerInstanceId], references: [id])

  @@index([entitlementId])
  @@index([providerType])
  @@index([status])
  @@index([providerInstanceId])
}

// ---------------------------------------------------------------------------
// Phase 2C.3.1 — Connectivity Provider Instance
// -----------------------------------------------------------------------------
// Represents a specific infrastructure instance (e.g., a specific MikroTik router,
// a specific eSIM supplier endpoint, a specific WiFi ISP platform).
//
// providerType selects the adapter CLASS (e.g., "mikrotik").
// providerInstance selects the specific infrastructure INSTANCE (e.g., "accra-router-01").
//
// Secrets/credentials MUST NOT be stored in plaintext. Use environment variables
// or a secrets manager referenced by configurationKey.
//
// Tenant isolation: a provider instance belongs to a tenant. Other tenants
// cannot use it.
// -----------------------------------------------------------------------------

model ConnectivityProviderInstance {
  id              String   @id @default(cuid())
  tenantId        String
  // Provider type: "mikrotik" | "wifi-isp" | "esim" | future
  providerType    String
  // Human-readable name: "Accra Router 01" | "Kumasi Router 02"
  name            String
  status          String   @default("active") // active | inactive | maintenance
  // Configuration reference — NOT secrets. E.g., endpoint URL, API version, region.
  // Secrets are resolved via environment variables or secrets manager using
  // the configurationKey as a lookup.
  configuration   String?  // JSON string of non-secret configuration
  configurationKey String? // reference to secrets manager key (e.g., "mikrotik-accra-01-creds")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resourceBindings ProviderResourceBinding[]

  @@index([tenantId])
  @@index([providerType])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 3 — Commercial Layer: Catalog + Orders
//
// These are the ONLY new commercial entities. They are thin layers connecting
// the reseller's catalog to the frozen entitlement kernel:
//
//   ConnectivityProduct (catalog entry)
//     → CustomerOrder (purchase)
//       → createEntitlement() [FROZEN kernel]
//         → provisionBinding() [FROZEN kernel]
//           → adapter.provision() [FROZEN contract]
//
// The product is provider-neutral in its capability description but may
// specify a providerType to route provisioning. The order is the commercial
// record; the entitlement is the provisioning record.
// ---------------------------------------------------------------------------

model ResellerProduct {
  id              String   @id @default(cuid())
  tenantId        String
  // Display name: "Accra WiFi 50Mbps Monthly" | "eSIM 5GB Roaming 30 Days"
  name            String
  description     String?
  // INTERNET | ROAMING | LOCAL_NETWORK | CACHE_ACCESS | MESH_RELAY | VPN_ACCESS
  capabilityType  String
  // mikrotik | esim | null (null = reseller chooses at provisioning time)
  providerType    String?
  // FLAT | USAGE_BASED | TIERED
  pricingModel    String   @default("FLAT")
  // Price in currency minor units (e.g., cents). 0 = free.
  priceMinor      Int      @default(0)
  currency        String   @default("USD")
  // monthly | one_time | prepaid
  billingCycle    String   @default("one_time")
  // JSON: { downloadMbps, uploadMbps, dataLimitBytes, allowedCountries, ... }
  // This is passed to createEntitlement() as the capabilitySet.
  capabilitySet   String
  status          String   @default("active") // active | archived
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders          CustomerOrder[]

  @@index([tenantId])
  @@index([capabilityType])
  @@index([providerType])
  @@index([status])
}

model CustomerOrder {
  id              String   @id @default(cuid())
  tenantId        String
  // The reseller's end customer (a User with role "customer")
  customerId      String
  productId       String
  // Created on fulfillment (after payment confirmation)
  entitlementId   String?
  status          String   @default("pending") // pending | paid | fulfilled | failed | refunded
  paidAmountMinor Int      @default(0)
  currency        String   @default("USD")
  // Payment provider reference (Stripe payment intent, Paystack reference, etc.)
  paymentRef      String?
  // JSON: { hotspotPassword, esimQrCode, activationLink, ... }
  // Populated on fulfillment with the credentials the customer needs.
  credentials     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product         ResellerProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([customerId])
  @@index([productId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Phase 4 — Reseller Operating System: Normalized Offers + Ranking Engine
//
// The core concept: every connectivity product — whether from a WiFi operator's
// own infrastructure, a telco reseller's imported catalog, or an eSIM supplier's
// roaming feed — is normalized into a ConnectivityOffer2 row that the ranking
// engine can compare on a level playing field.
//
// (Named ConnectivityOffer2 to avoid collision with the legacy B2C-era
// ConnectivityOffer model. A future cleanup can merge them.)
//
// A customer request (ConnectivityIntent) is resolved by the Offer Ranking
// Engine into a ranked list of ConnectivityOffer2 rows, scored by:
//   intent match + location match + availability + price + margin + reliability
//
// The reseller sets a markup (ResellerMarkup) on supplier offers to determine
// the customer-facing price. The reseller's own infrastructure offers have
// no markup (the reseller IS the supplier).
//
// This is the "Stripe + Shopify + AWS Marketplace for connectivity" layer:
//   - Stripe: payment collection (existing)
//   - Shopify: reseller catalog + storefront (Phase 3 + this)
//   - AWS Marketplace: supplier feeds + normalized offers + ranking (this)
// ---------------------------------------------------------------------------

// A normalized connectivity offer. One row per sellable unit of connectivity.
// Sources:
//   1. Reseller's own infrastructure (WiFi hotspot plan) — supplierId = null
//   2. Imported telecom product (telco reseller) — supplierId = Supplier
//   3. eSIM roaming product (eSIM supplier feed) — supplierId = Supplier
model ConnectivityOffer2 {
  id              String   @id @default(cuid())
  tenantId        String   // the reseller who owns/sells this offer

  // What kind of connectivity
  capabilityType  String   // INTERNET | ROAMING | LOCAL_NETWORK | VPN_ACCESS
  providerType    String   // mikrotik | esim | wifi-isp | telco | future

  // The normalized specification — what the customer gets
  // JSON: { downloadMbps, uploadMbps, dataLimitBytes, validityDays,
  //         allowedCountries[], allowedRegions[] }
  spec            String

  // Geographic coverage — for location-based ranking
  // JSON: { countries: ["GH","NG"], regions: ["West Africa"], cities: ["Accra"],
  //         lat, lng, radiusKm }
  coverage        String

  // Pricing (in currency minor units)
  wholesalePriceMinor Int   @default(0) // what the reseller pays the supplier (0 for own infra)
  customerPriceMinor  Int   @default(0) // what the customer pays (wholesale + markup)
  currency        String   @default("USD")

  // Source: who provides this connectivity
  // null = the reseller's own infrastructure (they ARE the supplier)
  // non-null = imported from a supplier feed
  supplierId      String?

  // Link to the reseller's product (if they've created a storefront product
  // from this offer). null = not yet listed in the storefront.
  resellerProductId String?

  // Availability + reliability (for ranking)
  status          String   @default("active") // active | suspended | exhausted | expired
  reliabilityScore Float   @default(0.5) // 0.0–1.0, updated by reconciliation
  lastProvisionedAt DateTime?
  lastFailedAt    DateTime?
  successCount    Int      @default(0)
  failureCount    Int      @default(0)

  // Validity window
  validFrom       DateTime @default(now())
  validUntil      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capability      ProtocolCapability? @relation(fields: [capabilityId], references: [id], onDelete: SetNull)
  capabilityId    String?

  @@index([tenantId])
  @@index([capabilityType])
  @@index([providerType])
  @@index([supplierId])
  @@index([status])
  @@index([capabilityId])
}

// A reseller's markup rule on supplier offers.
// The reseller can set a global default markup (on Tenant.defaultMarkupPercent)
// and override per-capability or per-supplier.
model ResellerMarkup {
  id              String   @id @default(cuid())
  tenantId        String
  // Scope: which offers does this markup apply to?
  // null = global default (overrides Tenant.defaultMarkupPercent)
  // non-null = scoped to a specific capabilityType, providerType, or supplierId
  capabilityType  String?
  providerType    String?
  supplierId      String?
  // The markup as a percentage added to wholesale price
  // customerPrice = wholesalePrice * (1 + markupPercent / 100)
  markupPercent   Float    @default(0)
  // OR a fixed markup in minor units (if markupPercent is 0)
  markupFixedMinor Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, capabilityType, providerType, supplierId])
  @@index([tenantId])
}

// A customer's connectivity request, to be resolved by the ranking engine.
// This is the "intent" that the ranking engine matches against offers.
model ConnectivityIntent {
  id              String   @id @default(cuid())
  tenantId        String   // the reseller's storefront
  customerId      String?

  // What the customer wants
  capabilityType  String?  // null = any
  // JSON: { downloadMbps, uploadMbps, dataLimitBytes, validityDays,
  //         allowedCountries[] }
  desiredSpec     String?

  // Where the customer is / wants connectivity
  // JSON: { country, region, city, lat, lng }
  location        String?

  // Budget constraint (in minor units)
  maxPriceMinor   Int?

  // The ranked results (stored for analytics + debugging)
  // JSON: [{ offerId, score, customerPrice, matchReasons[] }, ...]
  rankedResults   String?

  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Phase 6 — Business Layer: Reseller Economics + B2B + Intelligence
//
// Extends the existing commerce layer (not a replacement). Every financial
// action still goes through the frozen double-entry ledger. These models
// provide the commercial view on top of the ledger:
//   - ResellerEarning: what the reseller netted per order
//   - ProviderCost: what the reseller owes the supplier
//   - ResellerPayout: withdrawal of earnings
//   - IntentRequest: natural language intent → structured ranking
//   - EmployeeEntitlement: B2B employee connectivity
// ---------------------------------------------------------------------------

model ResellerEarning {
  id              String   @id @default(cuid())
  tenantId        String
  orderId         String
  customerPaymentMinor Int  // what the customer paid
  wholesaleCostMinor Int   // what the reseller paid the supplier (0 for own infra)
  paymentFeeMinor Int      // payment processing fee
  platformFeeMinor Int     // RoamLink's platform fee
  resellerEarningMinor Int // customerPayment - wholesale - paymentFee - platformFee
  currency        String   @default("USD")
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([orderId])
  @@index([tenantId])
}

model ProviderCost {
  id              String   @id @default(cuid())
  tenantId        String
  orderId         String
  offerId         String?
  supplierId      String?
  wholesaleCostMinor Int
  currency        String   @default("USD")
  status          String   @default("pending") // pending | settled | disputed
  settledAt       DateTime?
  ledgerTransactionId String?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@index([supplierId])
}

model ResellerPayout {
  id              String   @id @default(cuid())
  tenantId        String
  amountMinor     Int
  currency        String   @default("USD")
  status          String   @default("pending") // pending | processing | completed | failed
  method          String   // bank_transfer | mobile_money | stripe_transfer
  destinationRef  String?
  ledgerTransactionId String?
  processedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model IntentRequest {
  id              String   @id @default(cuid())
  tenantId        String
  customerId      String?
  rawText         String?
  parsedIntent    String   // JSON: { capabilityType, desiredSpec, location, maxPriceMinor }
  rankedOfferIds  String?  // JSON: [offerId, ...]
  selectedOfferId String?
  status          String   @default("pending") // pending | ranked | selected | purchased | expired
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model EmployeeEntitlement {
  id              String   @id @default(cuid())
  organizationId  String
  memberId        String
  entitlementId   String?
  productId       String?
  status          String   @default("pending") // pending | active | suspended | revoked
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([memberId])
}

// ---------------------------------------------------------------------------
// Phase 7 — Marketplace Reality: Settlement + Trust Signals
// ---------------------------------------------------------------------------

model SupplierSettlement {
  id              String   @id @default(cuid())
  tenantId        String
  supplierId      String
  periodStart     DateTime
  periodEnd       DateTime
  totalCostMinor  Int
  currency        String   @default("USD")
  status          String   @default("pending") // pending | invoiced | paid | disputed
  providerInvoiceId String?
  costCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, supplierId])
  @@index([status])
}

model OfferRating {
  id              String   @id @default(cuid())
  offerId         String
  tenantId        String
  customerId      String
  orderId         String
  rating          Int      // 1-5 stars
  review          String?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([orderId])
  @@index([offerId])
}

model UptimeMeasurement {
  id              String   @id @default(cuid())
  tenantId        String
  providerInstanceId String
  measuredAt      DateTime @default(now())
  isReachable     Boolean
  responseTimeMs  Int?

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, providerInstanceId])
  @@index([measuredAt])
}

// ---------------------------------------------------------------------------
// Phase 8 — Connectivity Control Plane: Protocol Models
// ---------------------------------------------------------------------------

model ConnectivitySession {
  id              String   @id @default(cuid())
  subjectId       String
  intentId        String?
  entitlementId   String?
  activeResourceId String?
  state           String   @default("PLANNED")
  policyId        String?
  startedAt       DateTime?
  lastObservedAt  DateTime?
  endedAt         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Phase 11.2: Session-level execution serialization primitive.
  // A session may have at most one connectivity mutation executing at a time.
  // The slot is acquired (DB-authoritative fenced updateMany) before a decision
  // creates/executes an action, and released after the action completes (success/
  // failure/reconciliation). A crashed worker's slot is reclaimable after lease
  // expiry (reclaimExpiredSessionSlots). This prevents two concurrent SWITCH
  // decisions for the same session from racing on session.activeResourceId and
  // leaving an orphaned target IN_USE.
  executionSlotClaimId      String?
  executionSlotClaimedAt    DateTime?
  executionSlotClaimExpiresAt DateTime?

  measurements    ConnectivityMeasurement[]
  decisions       ConnectivityDecision[]
  actions         ConnectivityAction[]
  policy          ConnectivityPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  // Phase 12.2 P0-5: Authoritative tenant linkage. A session's tenant is the
  // tenant of its entitlement. This relation enables the sessions GET route to
  // filter by tenant at the database query level (WHERE entitlement.tenantId =
  // ctx.tenantId AND entitlement.userId = user.id) BEFORE take/limit — not
  // fetch-then-filter in application code. onDelete: SetNull preserves session
  // history if an entitlement is deleted (the session becomes tenantless and
  // is excluded from tenant-scoped reads).
  entitlement     ConnectivityEntitlement? @relation(fields: [entitlementId], references: [id], onDelete: SetNull)

  @@index([subjectId])
  @@index([state])
  @@index([entitlementId])
  @@index([executionSlotClaimExpiresAt])
}

model ConnectivityMeasurement {
  id              String   @id @default(cuid())
  sessionId       String?
  resourceId      String?
  providerInstanceId String?
  type            String
  metrics         String
  // Phase 8.6: freshness computed from capturedAt at ingestion time.
  // FRESH (age<30s) | STALE (30s–120s) | EXPIRED (>120s) | UNKNOWN
  freshness       String   @default("UNKNOWN")
  // Phase 8.6: provenance — MUST be one of ADAPTER|DEVICE|PROBE|PROVIDER|DERIVED.
  source          String   @default("PROVIDER")
  confidence      Float    @default(0.5)
  capturedAt      DateTime @default(now())
  // Phase 8.6.5: Idempotent observation identity.
  deduplicationKey String? @unique
  // Phase 10: Server-derived trust classification.
  // TRUSTED | LIMITED | UNTRUSTED. The server alone derives trust.
  // UNTRUSTED measurements are stored but excluded from health derivation.
  trust           String   @default("TRUSTED")
  // Phase 10: Observation integrity state at ingestion.
  // VALID | STALE | FUTURE_TIMESTAMP | INVALID_METRIC | RESOURCE_MISMATCH | RATE_LIMITED
  // Phase 10.1.1: DUPLICATE is NOT a measurement-integrity state. It is an
  // ingestion outcome surfaced in EdgeObservationAck (duplicate=true), because
  // duplicate observations are deduped before validateObservation() runs and
  // never project to a persisted measurement. See packages/shared/src/observation-trust.ts.
  integrity       String   @default("VALID")

  session         ConnectivitySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([resourceId])
  @@index([capturedAt])
  @@index([source])
  @@index([freshness])
  @@index([trust])
  @@index([integrity])
}

model ConnectivityPolicy {
  id              String   @id @default(cuid())
  subjectId       String
  mode            String   @default("manual")
  maxAutoSpendMinor Int    @default(0)
  preferredTransports String?
  minReliability  Float    @default(0.5)
  switchHysteresis Float   @default(0.15)
  requireUserApprovalForPurchase Boolean @default(true)
  neverInterruptActiveCall Boolean @default(true)
  // Phase 9.3.2: Policy identity is first-class. The preset is stored
  // explicitly rather than reverse-engineered from parameters. A policy
  // created from RELIABLE carries preset="RELIABLE" even if the user later
  // customizes individual parameters (e.g. custom hysteresis).
  preset          String?
  // Phase 9.3.2: Policy version for provenance tracking. Incremented on
  // each update so decisions can reference the exact policy version used.
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions        ConnectivitySession[]

  @@index([subjectId])
}

model ConnectivityDecision {
  id              String   @id @default(cuid())
  intentId        String
  // Phase 9.4: Intent version provenance — which version of the intent was active
  intentVersion   Int?
  sessionId       String?
  action          String
  targetResourceId String?
  targetOfferId   String?
  score           Float
  constraintsSatisfied String?
  constraintsViolated String?
  reasons         String?
  // Phase 9.5 (R1): Canonical machine-readable reason codes (JSON array).
  // Deterministic, evidence-backed. AI never generates these.
  reasonCodes     String?
  policyVersion   String?
  // Phase 9.3.2: Durable decision provenance. A persisted decision can answer:
  //   What policy caused this? What device context? What derivation?
  basePolicyId    String?
  basePolicyVersion Int?
  basePreset      String?
  contextDeviceId String?
  contextVersion  Int?
  contextObservedAt DateTime?
  effectivePreset String?
  derivationReasons String?
  // Phase 8.6.5: Separation of decision triggering from decision execution.
  // The reevaluation worker produces a Decision (PENDING); a separate
  // decision-executor turns non-KEEP decisions into Actions (EXECUTED/FAILED).
  // KEEP/WAIT/ASK_USER decisions are SKIPPED (no action needed).
  // Phase 8.6.6: Fenced execution — PENDING → EXECUTION_CLAIMED → EXECUTING
  //   → EXECUTED | FAILED | RECONCILIATION_REQUIRED | SKIPPED.
  //   Two workers cannot execute the same decision concurrently.
  // Phase 11.1: DEAD_LETTER state for poison decisions (exceeded MAX_ATTEMPTS).
  executionState  String   @default("PENDING") // PENDING | EXECUTION_CLAIMED | EXECUTING | EXECUTED | FAILED | RECONCILIATION_REQUIRED | SKIPPED | DEAD_LETTER
  // Phase 8.6.6: Execution fencing — only the worker holding executionClaimId
  // may execute the decision. Expired claims are reclaimable.
  executionClaimId String?
  executionClaimedAt DateTime?
  executionClaimExpiresAt DateTime?
  // Phase 11.1: Attempt count — incremented each time the decision is claimed
  // for execution. Bounds the crash-retry loop: a decision that crashes the
  // worker more than DECISION_MAX_ATTEMPTS times is dead-lettered (poison-
  // decision protection, parallel to ReevaluationEvent dead-lettering).
  executionAttemptCount Int @default(0)
  executedAt      DateTime?
  // Phase 8.6.6: The action id produced by execution (audit link).
  executedActionId String?
  createdAt       DateTime @default(now())

  session         ConnectivitySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  actions         ConnectivityAction[]

  @@index([intentId])
  @@index([sessionId])
  @@index([executionState])
  @@index([executionClaimExpiresAt])
  @@index([basePolicyId])
}

model ConnectivityAction {
  id              String   @id @default(cuid())
  sessionId       String
  decisionId      String?
  type            String
  targetResourceId String?
  state           String   @default("PLANNED")
  reason          String?
  policyVersion   String?
  idempotencyKey  String   @unique
  kernelExecutionId String?
  // Phase 8.5.9: Recovery-worker fencing — unique claim token per worker
  recoveryClaimId String?
  recoveryClaimedAt DateTime?
  // Phase 8.5.10: Recovery lease expiry — abandoned claims can be reclaimed
  recoveryClaimExpiresAt DateTime?
  createdAt       DateTime @default(now())
  executedAt      DateTime?
  completedAt     DateTime?
  error           String?

  session         ConnectivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  decision        ConnectivityDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([decisionId])
  @@index([state])
  @@index([recoveryClaimId])
}

// ---------------------------------------------------------------------------
// Phase 8.3 — First-class Protocol Models (Capability + Resource)
//
// The auditor correctly identified that using ConnectivityOffer2 with zero
// pricing as a "capability" collapses supply and commerce. These models
// separate them:
//
//   ConnectivityCapability = what CAN be provided (technical supply)
//   ConnectivityResource   = what ACTUALLY EXISTS (allocatable instance)
//   ConnectivityOffer2     = commercial realization (price + terms)
//
// Relationship: Capability → Resources → Offers
// ---------------------------------------------------------------------------

model ProtocolCapability {
  id              String   @id @default(cuid())
  tenantId        String
  providerInstanceId String
  type            String   // INTERNET | ROAMING | LOCAL_NETWORK | VPN_ACCESS
  providerType    String   // mikrotik | esim | telco | future
  // JSON: { downloadMbps, uploadMbps, typicalLatencyMs, maxLatencyMs, mobility, metering }
  technicalSpec   String
  // JSON: { countries, regions, cities, lat, lng, radiusKm }
  coverage        String
  reliability     Float    @default(0.5)
  status          String   @default("active") // active | suspended | retired
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  resources       ProtocolResource[]
  offers          ConnectivityOffer2[]

  @@index([tenantId])
  @@index([providerInstanceId])
  @@index([type])
  @@index([status])
}

model ProtocolResource {
  id              String   @id @default(cuid())
  capabilityId    String
  providerInstanceId String
  // JSON: { hotspotId, iccid, sessionId, ipAddress, ... }
  identifiers     String?
  state           String   @default("AVAILABLE") // AVAILABLE | IN_USE | DEGRADED | OFFLINE | RESERVED
  // JSON: { maxConcurrentUsers, totalBandwidthMbps, availableBandwidthMbps }
  capacity        String?
  location        String?  // JSON: { country, region, city, lat, lng }
  reservedAt      DateTime?
  reservedBy      String?  // session ID
  // Phase 8.5.7: explicit link to the frozen kernel's ProviderResourceBinding.
  // Eliminates the identity ambiguity: ProtocolResource #17 → which binding?
  providerBindingId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  capability      ProtocolCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([capabilityId])
  @@index([providerInstanceId])
  @@index([state])
}

// ---------------------------------------------------------------------------
// Phase 8.6 — Continuous Connectivity Observation
//
// ResourceHealth is the persisted, derived health snapshot for a resource.
// It is computed from the measurement stream by deriveResourceHealth() and
// consumed by the decision engine. Persisting it (rather than recomputing ad
// hoc in the decision engine) makes hysteresis a genuine control-system
// property: health is queryable, auditable, and event-addressable.
// ---------------------------------------------------------------------------

model ResourceHealth {
  id              String   @id @default(cuid())
  resourceId      String   @unique
  sessionId       String?
  // HEALTHY | DEGRADED | UNKNOWN
  status          String   @default("UNKNOWN")
  // Normalized quality 0–1 derived from the last-N measurement samples.
  quality         Float    @default(0)
  sampleCount     Int      @default(0)
  degradedCount   Int      @default(0)
  // Freshness of the most recent sample that fed this snapshot.
  freshness       String   @default("UNKNOWN")
  // Provenance mix that fed this snapshot (e.g. "ADAPTER" or "ADAPTER+DEVICE").
  derivedFromSources String?
  // The measurement id of the most recent sample (audit link).
  latestMeasurementId String?
  // Phase 10: Trust level of the evidence that fed this snapshot.
  // TRUSTED | LIMITED | UNTRUSTED. Orthogonal to health status.
  // TRUSTED = at least one trusted (provider/server) measurement contributed.
  // LIMITED = only device (LIMITED-trust) measurements contributed.
  // UNTRUSTED = no eligible measurements (only UNTRUSTED or none).
  trust           String   @default("UNTRUSTED")
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([sessionId])
  @@index([trust])
}

// ---------------------------------------------------------------------------
// Phase 8.6 — Re-evaluation Events
//
// Persisted events that may trigger a decision re-evaluation. The ingestion
// layer emits them; a worker (or the synchronous path) processes them. This
// replaces blind polling with event-driven re-evaluation — the foundation for
// a lightweight mobile agent.
// ---------------------------------------------------------------------------

model ReevaluationEvent {
  id              String   @id @default(cuid())
  // MEASUREMENT_RECEIVED | RESOURCE_DEGRADED | RESOURCE_RECOVERED |
  // QUOTA_THRESHOLD_REACHED | PROVIDER_UNAVAILABLE | LOCATION_CHANGED |
  // POLICY_CHANGED
  type            String
  resourceId      String?
  sessionId       String?
  subjectId       String?
  payload         String   // JSON
  // Phase 8.6.5: Event lifecycle — same fencing pattern as action recovery.
  // PENDING → CLAIMED → (PROCESSING) → COMPLETED | FAILED | DEAD_LETTER
  state           String   @default("PENDING")
  // Idempotent event identity: duplicate emissions of the same logical event
  // (e.g. two probes of the same observation) collapse to one.
  idempotencyKey  String?  @unique
  // Worker fencing — only the worker holding claimId may process the event.
  claimId         String?
  claimedAt       DateTime?
  claimExpiresAt  DateTime?
  attemptCount    Int      @default(0)
  lastError       String?
  // Legacy completion markers (state is now authoritative; kept for read compat).
  processedAt     DateTime?
  result          String?
  createdAt       DateTime @default(now())

  @@index([processedAt])
  @@index([state])
  @@index([type])
  @@index([resourceId])
  @@index([sessionId])
  @@index([claimExpiresAt])
}

// ---------------------------------------------------------------------------
// Phase 9.1 — Edge Observation (mobile agent contract)
//
// The mobile agent uploads EdgeObservation events. These are IMMUTABLE — the
// server derives authoritative ConnectivityMeasurement from them (source=DEVICE).
// The device never submits health/decisions; the control plane remains
// authoritative.
//
//   EdgeObservation (immutable, device-reported)
//        → ConnectivityMeasurement (derived, source=DEVICE)
//        → ResourceHealth (projection)
//        → ReevaluationEvent → Decision → Action
// ---------------------------------------------------------------------------

model EdgeDevice {
  id              String   @id @default(cuid())
  deviceId        String   @unique // client-generated stable identifier
  userId          String   // authenticated owner — validated on every request
  platform        String   // ios | android | web | unknown
  appVersion      String
  registeredAt    DateTime @default(now())
  lastSeenAt      DateTime? // updated on each observation upload
  // Phase 9.3: Persisted policy context (last-known). The device reports
  // context hints; the server applies them to the policy engine. Persisting
  // the context lets the mobile settings UI read the current state.
  // Phase 9.3.1: This is a CONTEXT SNAPSHOT, not authoritative policy.
  // Device context (batterySaver, roaming, metered) is transient and
  // per-device. It does NOT overwrite the user's base policy. The decision
  // engine derives an effective policy from base policy + device context.
  policyContext   String?  // JSON of EdgePolicyContext (context snapshot)
  policyContextUpdatedAt DateTime?
  // Phase 9.3.1: Versioning + timestamp fencing for context updates.
  // A stale update (observedAt < current) is rejected to prevent network
  // reordering from regressing the context.
  policyContextVersion Int  @default(0)
  policyContextObservedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  observations    EdgeObservationRecord[]

  @@index([userId])
}

model EdgeObservationRecord {
  id              String   @id @default(cuid())
  // Idempotent dedup: observationId is caller-supplied UUID. Duplicate uploads
  // collapse to one row (unique constraint).
  observationId   String   @unique
  deviceId        String
  userId          String   // denormalized for fast auth-scoped queries
  sessionId       String?
  // The resource the device BELIEVES it's using. Validated against the
  // authenticated session's active resource — treated as a HINT, not authoritative.
  resourceId      String?
  sequence        Int      // per-device monotonic sequence
  source          String   // DEVICE | PROBE
  observedAt      DateTime
  // The full observation payload (connectivity, network, location, device context).
  payload         String   // JSON
  // The derived ConnectivityMeasurement id (audit link to the control plane).
  derivedMeasurementId String?
  receivedAt      DateTime @default(now())

  edgeDevice      EdgeDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, sequence]) // per-device sequence dedup
  @@index([deviceId])
  @@index([userId])
  @@index([sessionId])
  @@index([resourceId])
  @@index([observedAt])
}

// ---------------------------------------------------------------------------
// Phase 9.4 — Durable Connectivity Intent
//
// A declarative request for a connectivity outcome. It is NOT a command.
// The decision engine translates intent → decision → action.
//
//   Intent → ReevaluationEvent → Decision Engine → Decision → Action
//
// NOT: Intent → Action
//
// Versioning: each update creates a new version. A newer version supersedes
// the older one. An offline replay of an older version is rejected.
// ---------------------------------------------------------------------------

model ConnectivityIntentRecord {
  id                  String   @id @default(cuid())
  intentId            String   // stable identifier across versions
  subjectId           String   // authenticated user who created this intent
  deviceId            String?  // optional device scope
  version             Int      @default(1) // monotonic per intentId
  status              String   @default("ACTIVE") // ACTIVE | SUPERSEDED | EXPIRED | FULFILLED | CANCELLED
  supersedesIntentId  String?
  supersedesVersion   Int?
  expiresAt           DateTime?
  priority            String   @default("NORMAL") // LOW | NORMAL | HIGH | CRITICAL
  source              String   @default("USER") // USER | AI_PROPOSAL | COMMERCIAL | SYSTEM

  // Phase 9.4.1: Idempotency key for offline-safe intent creation.
  // A mobile retry with the same idempotencyKey returns the existing intent
  // rather than creating a duplicate.
  idempotencyKey      String?  @unique

  // Declarative content (JSON — matches ConnectivityIntentSchema)
  payload             String   // JSON of the intent specification

  // Timestamps
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  supersededAt        DateTime?
  // Phase 11.4.9: Execution-authority fence marker. A conditional UPDATE on
  // this field (WHERE status=ACTIVE AND expiresAt>now) establishes a DB write
  // lock at the mutation boundary — a SELECT inside a transaction is NOT a
  // fence on PostgreSQL. This field is bumped by verifyIntentAuthorityAtBoundary
  // to take the row lock + evaluate the authority predicate atomically.
  fenceVersion        Int      @default(0)
  // Phase 11.4.10.1: Durable execution fence. When an intent is claimed for
  // execution, executionFenceId is set + executionFenceExpiresAt is set.
  // This fence PERSISTS through the mutation window (unlike the fenceVersion
  // bump which commits immediately). Every fenced resource mutation must
  // verify the intent's executionFenceId matches the decision's claim AND
  // the fence has not expired — inside the same $transaction as the resource
  // mutation. This is the same pattern as the session-slot lease fence (11.2.5).
  executionFenceId      String?
  executionFenceExpiresAt DateTime?

  // Phase 12.4.4c: Asynchronous causality provenance.
  // The control plane is event-driven — intents are created via API requests,
  // processed asynchronously via reevaluation events, and executed as decisions
  // + actions. Without persisting the originating request's correlation, the
  // provider log cannot trace back to "which API request caused this mutation?"
  //
  // sourceRequestId: the x-request-id from the API request that created/superseded
  //   this intent. For non-HTTP triggers (device events, system jobs), this is
  //   the event/job ID instead. null = unknown (legacy or internal trigger).
  // sourceChannel: "api" | "device" | "system" | "commercial" — how this intent
  //   was initiated. Lets operators distinguish user-driven vs system-driven
  //   connectivity changes.
  sourceRequestId     String?
  sourceChannel        String?

  // Phase 12.4.4e (P0-1): Authoritative tenant ownership for this intent version.
  //
  // BEFORE this field, incident lookup by requestId/intentId resolved tenant
  // ownership via "latest entitlement for user" — which is unsafe for users
  // belonging to multiple tenants (Tenant B's newer entitlement would shadow
  // Tenant A's incident).
  //
  // With this field, the intent record carries its OWN authoritative tenantId,
  // set at creation time from the API principal's tenantId. Incident lookup
  // resolves tenant ownership directly from this field — no "latest entitlement"
  // shortcut.
  //
  // Nullable for backward compat with legacy intent records created before
  // Phase 12.4.4e. For legacy records, lookup falls back to the authoritative
  // decision→session→entitlement→tenant chain (NOT "latest entitlement").
  tenantId             String?

  @@unique([intentId, version]) // version fencing
  @@index([subjectId])
  @@index([intentId])
  @@index([status])
  @@index([expiresAt])
  @@index([sourceRequestId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Phase 9.1 — Edge Observation (mobile agent contract)
//
// The mobile agent uploads EdgeObservation events. These are IMMUTABLE — the
// server derives authoritative ConnectivityMeasurement from them (source=DEVICE).
// The device never submits health/decisions; the control plane remains
// authoritative.
//
//   EdgeObservation (immutable, device-reported)
//        → ConnectivityMeasurement (derived, source=DEVICE)
//        → ResourceHealth (projection)
//        → ReevaluationEvent → Decision → Action
// ---------------------------------------------------------------------------


// ---------------------------------------------------------------------------
// Phase 12.4.4e — Provider Operation Audit Record
//
// A DURABLE, QUERYABLE record of every provider-side operation performed by
// the adapter. This is NOT a second control plane — it is a read-only audit
// trail that lets operators reconstruct what the provider actually did, when,
// with what outcome, and on behalf of which request.
//
// Why this exists (and not just structured logs):
//   - Structured logs roll off and are not queryable by tenant/scope.
//   - The IdempotencyOperation table captures the OUTCOME of commerce-side
//     external operations (payment, topup), not the adapter's connectivity
//     operations (provision, suspend, resume, release, getUsage, reconcile).
//   - Without a persisted record, an operator investigating "did the router
//     actually get the PUT for request X?" has no authoritative answer.
//
// What this is NOT:
//   - It is NOT a duplicate event store. It does not drive reevaluation.
//   - It is NOT the source of truth for binding state (ProviderResourceBinding
//     is). It records the OPERATION — what was attempted, what the provider
//     returned, what classification the adapter assigned.
//   - It is NEVER used by the control plane to make decisions. The control
//     plane reads its own authoritative state (binding, session, intent).
//
// DURABLE LIFECYCLE (Phase 12.4.4e P0-2):
//   The record is NOT fire-and-forget. It follows a durable lifecycle:
//
//     STARTED (created BEFORE the provider mutation)
//       ↓
//     provider mutation executes
//       ↓
//     SUCCEEDED | FAILED_PERMANENT | FAILED_RETRYABLE | AMBIGUOUS
//       (terminal update AFTER the provider result)
//
//   If the process crashes after the provider mutation but before the terminal
//   update, the record remains STARTED. An operator can identify incomplete
//   operations and investigate manually. The audit layer NEVER auto-retries
//   or triggers reconciliation — it is observational only.
//
//   If the terminal update itself fails (DB write error), the provider result
//   remains authoritative — the control-plane execution does NOT become FAILED
//   merely because the audit write failed. The record stays STARTED and is
//   recoverable/reconcilable.
//
// Safety:
//   - No credentials, secrets, tokens, API keys, or passwords are stored.
//   - Only correlation identifiers + outcome + classification.
//
// Tenant authority (Phase 12.4.4e P0-3):
//   tenantId is REQUIRED on every record. The adapter resolves it from the
//   correlation context (enriched from ProtocolCapability.tenantId by
//   executeAction → kernel-bridge). There is no legitimate production need for
//   tenantless provider operation records — every production provider operation
//   is initiated by the control plane, which always has a tenantId.
//
// Lookup keys (Phase 12.4.4e):
//   - requestId     — the originating API request (intent.sourceRequestId)
//   - actionId      — the control-plane action that caused this operation
//   - tenantId      — tenant scope (required)
//   - providerInstanceId — which infrastructure endpoint
//   - providerResourceId — which provider-side resource
//   - bindingId     — which binding
//   - providerKey    — the external idempotency key (commerce ops only)
// ---------------------------------------------------------------------------

model ProviderOperationRecord {
  id              String   @id @default(cuid())
  // Operation type: "provision" | "suspend" | "resume" | "release" | "getUsage" | "reconcile"
  operation       String
  // Lifecycle state (Phase 12.4.4e P0-2):
  //   STARTED           — record created BEFORE the provider mutation. The
  //                       operation is in progress (or the process crashed
  //                       before the terminal update — see DURABLE LIFECYCLE above).
  //   SUCCEEDED         — provider mutation succeeded. Terminal.
  //   FAILED_PERMANENT  — provider returned a permanent failure (auth, config).
  //                       Terminal. NOT retryable.
  //   FAILED_RETRYABLE  — provider returned a transient failure (timeout, 5xx).
  //                       Terminal. Retryable.
  //   AMBIGUOUS         — provider outcome is unknown (crash after mutation,
  //                       lost response). Terminal. Requires reconciliation.
  //   RECONCILIATION_REQUIRED — the adapter explicitly classified this as
  //                       requiring reconciliation (e.g., uncertain create
  //                       safety from Phase 12.4.2a.1). Terminal.
  state           String   @default("STARTED")
  // Outcome detail — only present in terminal states. JSON:
  //   { errorClass, message, statusCode, retryable }
  // Never contains credentials. The message is the adapter's safe classification
  // summary, NOT the raw provider response (which may contain secrets).
  outcome         String?
  outcomeDetail   String?
  // The provider's own resource identifier (e.g., RouterOS hotspot user ID)
  providerResourceId String?
  // The provider-neutral binding (link to ProviderResourceBinding)
  bindingId       String?
  // The infrastructure instance
  providerInstanceId String?
  // The provider type (mikrotik, mock, esim, etc.) — selects the adapter class
  providerType    String?
  // Tenant scope (REQUIRED — Phase 12.4.4e P0-3). The adapter resolves it
  // from the correlation context. There is no legitimate production need for
  // tenantless records.
  tenantId        String
  // Correlation chain (Phase 12.4.4 — full incident trail)
  requestId       String?
  intentId        String?
  decisionId      String?
  actionId        String?
  sessionId       String?
  // External idempotency correlation (commerce ops only — control-plane ops
  // use provisioning-lease, not providerKey, per Phase 12.4.4b.3)
  providerKey     String?
  // Reconciliation state at the time of the operation (snapshot)
  reconciliationState String?
  // Phase 12.4.4f: Recovery ownership for STARTED records.
  // When a recovery worker claims a STARTED record, it sets recoveryClaimId
  // and recoveryClaimExpiresAt. This prevents two recovery workers from
  // querying the provider simultaneously for the same operation.
  // A crashed recovery worker's claim is reclaimable after expiry.
  recoveryClaimId        String?
  recoveryClaimedAt      DateTime?
  recoveryClaimExpiresAt DateTime?
  // Timestamps
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([tenantId])
  @@index([state])
  @@index([requestId])
  @@index([actionId])
  @@index([providerInstanceId])
  @@index([providerResourceId])
  @@index([bindingId])
  @@index([providerKey])
  @@index([startedAt])
  @@index([recoveryClaimId])
  @@index([recoveryClaimExpiresAt])
}

// ---------------------------------------------------------------------------
// Phase 12.4.6.2 — Rate Limit Event (DB-authoritative sliding window)
//
// Each API request creates a RateLimitEvent row. The limiter counts events
// in the sliding window (1 minute) and rejects if the count exceeds the limit.
// Events are pruned by the connectivity-reconcile cron (events older than 5 min).
//
// Scopes:
//   key       — per API key (DEFAULT_KEY_LIMIT_PER_MINUTE = 100)
//   tenant    — per tenant aggregate (DEFAULT_TENANT_LIMIT_PER_MINUTE = 500)
//   sensitive — per tenant+path for sensitive endpoints (SENSITIVE_ENDPOINT_LIMIT = 10)
// ---------------------------------------------------------------------------

model RateLimitEvent {
  id          String   @id @default(cuid())
  tenantId    String
  scope       String   // "key" | "tenant" | "sensitive"
  scopeId     String   // apiKeyId | tenantId | "tenantId:path"
  path        String
  createdAt   DateTime @default(now())

  @@index([scope, scopeId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Phase 12.4.6.1 — Rate Limit Counter (atomic fixed-window counter)
//
// Each (scope, scopeId, windowKey) has a counter row. The limiter performs a
// conditional UPDATE (increment WHERE count < limit) which is DB-authoritative:
// two concurrent requests cannot both increment past the limit because the
// conditional WHERE is evaluated atomically by the database.
//
// Scopes:
//   key       — per API key (DEFAULT_KEY_LIMIT_PER_MINUTE = 100)
//   tenant    — per tenant aggregate (DEFAULT_TENANT_LIMIT_PER_MINUTE = 500)
//   sensitive — per tenant+path for sensitive endpoints (SENSITIVE_ENDPOINT_LIMIT = 10)
//
// windowKey: minute-granularity ISO timestamp (e.g., "2024-01-15T10:23")
// expiresAt: used for cleanup pruning (5 minutes after window ends)
// ---------------------------------------------------------------------------

model RateLimitCounter {
  id          String   @id @default(cuid())
  scope       String   // "key" | "tenant" | "sensitive"
  scopeId     String   // apiKeyId | tenantId | "tenantId:path"
  windowKey   String   // minute-granularity ISO timestamp
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([scope, scopeId, windowKey])
  @@index([expiresAt])
}
