// =============================================================================
// eSIM Marketplace — Prisma Schema
// -----------------------------------------------------------------------------
// DATABASE: PostgreSQL (Neon) is the canonical database for development,
// staging, and production. SQLite is NOT supported. Money is stored as Int
// (minor units) — never float.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// User & Authentication
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  role          String   @default("customer") // "customer" | "admin"
  isDemo        Boolean  @default(false) // demo accounts (quick-login)
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions              Session[]
  orders                Order[]
  esims                 Esim[]
  payments              Payment[]
  topUps                TopUp[]
  auditLogs             AuditLog[]
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  approvedFrom          WaitlistEntry?
  approvedWaitlist      WaitlistEntry[] @relation("WaitlistApprover")
  orgMemberships        OrganizationMember[]
  virtualNumbers        VirtualNumber[]
  numberSubscriptions   NumberSubscription[]
}

model WaitlistEntry {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  status      String   @default("pending") // pending | approved | rejected
  note        String?  // admin note
  approvedById String? // admin user who approved
  approvedAt  DateTime?
  createdUserId String? @unique // the User created when approved (1:1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  approvedBy  User?    @relation("WaitlistApprover", fields: [approvedById], references: [id])
  createdUser User?    @relation(fields: [createdUserId], references: [id])

  @@index([status])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  expiresAt    DateTime
  userAgent    String?
  ip           String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Plans (canonical marketplace model — never provider-native shape)
// ---------------------------------------------------------------------------

model Plan {
  id              String   @id @default(cuid())
  providerId      String   // internal provider key, e.g. "mock"
  providerPlanId  String   // provider's native plan id
  name            String
  description     String?
  country         String
  countryCode     String   // ISO 3166-1 alpha-2
  region          String   // e.g. "Africa", "Europe", "North America"
  dataAmount      Int      // in MB (1024 = 1 GB)
  dataUnit        String   @default("MB")
  validityDays    Int
  // Money — integer minor units (cents). See lib/money.ts.
  price           Int      // retail price in minor units
  wholesalePrice  Int      // internal cost, NEVER exposed to customers
  currency        String   @default("USD")
  coverage        String?  // comma-separated countries / description
  networks        String?  // JSON string: ["MTN","Vodafone"]
  roaming         Boolean  @default(false)
  hotspot         Boolean  @default(true)
  speed           String?  // e.g. "4G/5G"
  topUpSupported  Boolean  @default(true)
  status          String   @default("active") // "active" | "inactive"
  // Pricing rule that produced `price` (audit). JSON string.
  pricingRule     String?
  // Provider-native payload (never sent to client). JSON string.
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          Order[]

  @@unique([providerId, providerPlanId])
  @@index([countryCode])
  @@index([region])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id               String   @id @default(cuid())
  userId           String
  planId           String?  // nullable for virtual-number orders (no Plan row)
  productType      String   @default("esim") // esim | virtual_number
  // State machine: PLAN_SELECTED | CHECKOUT_CREATED | PAYMENT_PENDING |
  // PAYMENT_CONFIRMED | ESIM_PROVISIONING | ESIM_PROVISIONED | COMPLETED |
  // PAYMENT_FAILED | PROVISIONING_FAILED | CANCELLED | REFUNDED
  status           String   @default("PLAN_SELECTED")
  amount           Int      // total charged (minor units)
  currency         String   @default("USD")
  paymentStatus    String   @default("pending") // pending | succeeded | failed | refunded
  paymentProvider  String?
  paymentReference String?  // provider's payment intent / charge id
  providerOrderId  String?  // eSIM provider order id
  // Idempotency: prevents duplicate orders / payments / provisioning on retry.
  idempotencyKey   String   @unique
  // Snapshot of plan at purchase time (so historical orders stay accurate).
  planSnapshot     String?  // JSON string
  failureReason    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             Plan?    @relation(fields: [planId], references: [id])
  payments         Payment[]
  esim             Esim?
  corporateOrder   CorporateOrder?
  virtualNumber    VirtualNumber? @relation("VirtualNumberOrder")

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id               String   @id @default(cuid())
  userId           String
  orderId          String
  amount           Int
  currency         String   @default("USD")
  status           String   @default("pending") // pending | succeeded | failed | refunded
  provider         String
  providerReference String?
  // Idempotency key from the client payment attempt.
  idempotencyKey   String?  @unique
  raw              String?  // provider response (server-side only), JSON string
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// eSIMs
// ---------------------------------------------------------------------------

model Esim {
  id              String    @id @default(cuid())
  userId          String
  orderId         String    @unique // one eSIM per order (1:1)
  provider        String
  providerESIMId  String?   // provider's native esim id
  iccid           String?   // 19-20 digit Integrated Circuit Card ID
  smdpAddress     String?   // SM-DP+ server address
  activationCode  String?   // LPA activation code
  matchId         String?   // optional confirmation code
  qrCode          String?   // generated QR payload (LPA string)
  status          String    @default("pending") // pending|active|expired|suspended|exhausted|cancelled
  dataAmount      Int       // total allowance in MB
  dataRemaining   Int       // remaining in MB
  validityDays    Int
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  usages          Usage[]
  topUps          TopUp[]
  orgAssignments  OrganizationESIM[]

  @@index([userId])
  @@index([status])
  @@index([iccid])
}

// ---------------------------------------------------------------------------
// Usage tracking
// ---------------------------------------------------------------------------

model Usage {
  id            String   @id @default(cuid())
  esimId        String
  dataUsed      Int      // MB used in this sample
  dataRemaining Int      // MB remaining at sample time
  source        String   @default("provider") // provider | simulated
  timestamp     DateTime @default(now())

  esim          Esim     @relation(fields: [esimId], references: [id], onDelete: Cascade)

  @@index([esimId])
}

// ---------------------------------------------------------------------------
// Top-ups
// ---------------------------------------------------------------------------

model TopUp {
  id               String   @id @default(cuid())
  esimId           String
  userId           String
  amount           Int      // charged (minor units)
  currency         String   @default("USD")
  dataAmount       Int      // MB added
  paymentStatus    String   @default("pending") // pending | succeeded | failed
  providerReference String?
  idempotencyKey   String   @unique
  createdAt        DateTime @default(now())

  esim             Esim     @relation(fields: [esimId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([esimId])
}

// ---------------------------------------------------------------------------
// Webhook events (idempotent delivery log)
// ---------------------------------------------------------------------------

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventType   String
  externalId  String?  // provider's event id, used for dedup
  payload     String   // JSON string
  processed   Boolean  @default(false)
  error       String?
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@unique([provider, externalId])
  @@index([provider, eventType])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  orderId   String?
  action    String
  entity    String   // order | esim | payment | plan | user
  entityId  String?
  detail    String?  // JSON string
  ip        String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Pricing rules (markup engine)
// ---------------------------------------------------------------------------

model PricingRule {
  id         String   @id @default(cuid())
  name       String
  type       String   // "fixed" | "percentage"
  value      Int      // fixed: minor units; percentage: basis points (30% = 3000)
  scope      String   @default("global") // global | country | region
  scopeValue String?  // countryCode / region when scoped
  priority   Int      @default(0) // higher wins
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([scope, scopeValue])
}

// ---------------------------------------------------------------------------
// Notifications log (development implementation)
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  channel   String   // email | sms | push | whatsapp | log
  event     String
  recipient String?
  subject   String?
  body      String
  status    String   @default("sent") // sent | failed
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([event])
}

// ---------------------------------------------------------------------------
// Installation tokens — short-lived, secure tokens for web→mobile deep linking.
// A web purchase generates a token; the mobile app consumes it to install the
// eSIM. Never expose raw activation secrets in permanent URLs.
// ---------------------------------------------------------------------------

model InstallToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  esimId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([esimId])
}

// ---------------------------------------------------------------------------
// B2B foundation — organizations, members, corporate eSIMs.
// Built as a foundation so corporate features can be added without redesigning
// authentication. Not fully implemented yet.
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active") // active | suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  esims     OrganizationESIM[]
  orders    CorporateOrder[]
  numbers   VirtualNumber[] @relation("OrgNumbers")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member") // owner | admin | member
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationESIM {
  id             String   @id @default(cuid())
  organizationId String
  esimId         String
  assignedTo     String?  // employee name/email
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  esim           Esim        @relation(fields: [esimId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([esimId])
}

model CorporateOrder {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String   @unique
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Virtual Numbers — second connectivity product alongside eSIMs.
// Reuses: User, Organization, Order, Payment, WebhookEvent, AuditLog.
// ---------------------------------------------------------------------------

model VirtualNumber {
  id              String    @id @default(cuid())
  e164            String    @unique // e.g. "+233241234567"
  country         String
  countryCode     String
  region          String?
  city            String?
  numberType      String    @default("local") // local | toll_free | mobile | national
  smsEnabled      Boolean   @default(false)
  mmsEnabled      Boolean   @default(false)
  voiceEnabled    Boolean   @default(false)
  // Lifecycle: discovered | available | reserved | provisioning | configuring | active | suspended | releasing | released | failed
  status          String    @default("available")
  provider        String    // e.g. "mock", "telnyx", "twilio"
  providerNumberId String?  // provider's native number id
  providerCost    Int       // wholesale cost in minor units (monthly)
  sellingPrice    Int       // customer price in minor units (monthly)
  currency        String    @default("USD")
  userId          String?
  organizationId  String?
  orderId         String?   @unique // 1:1 with the order that purchased it
  activatedAt     DateTime?
  releasedAt      DateTime?
  expiresAt       DateTime? // subscription expiry
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  order           Order?          @relation("VirtualNumberOrder", fields: [orderId], references: [id], onDelete: SetNull)
  organization    Organization?   @relation("OrgNumbers", fields: [organizationId], references: [id], onDelete: SetNull)
  messages        Message[]
  calls           Call[]
  subscriptions   NumberSubscription[]

  @@index([userId])
  @@index([organizationId])
  @@index([countryCode])
  @@index([status])
}

model NumberSubscription {
  id              String    @id @default(cuid())
  virtualNumberId String
  userId          String
  status          String    @default("active") // active | past_due | suspended | cancelled | expired | trial
  billingCycle    String    @default("monthly") // monthly | yearly
  currentPeriodEnd DateTime
  trialEndsAt     DateTime?
  cancelledAt     DateTime?
  idempotencyKey  String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  virtualNumber   VirtualNumber @relation(fields: [virtualNumberId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([virtualNumberId])
  @@index([status])
}

model Message {
  id              String   @id @default(cuid())
  virtualNumberId String
  direction       String   // inbound | outbound
  fromNumber      String
  toNumber        String
  body            String
  status          String   @default("received") // received | sent | delivered | failed
  providerMessageId String?
  segments        Int      @default(1)
  createdAt       DateTime @default(now())

  virtualNumber   VirtualNumber @relation(fields: [virtualNumberId], references: [id], onDelete: Cascade)

  @@index([virtualNumberId])
  @@index([createdAt])
}

model Call {
  id              String   @id @default(cuid())
  virtualNumberId String
  direction       String   // inbound | outbound
  fromNumber      String
  toNumber        String
  status          String   @default("completed") // ringing | in_progress | completed | failed | no_answer | busy
  durationSeconds Int      @default(0)
  providerCallId  String?
  recordingUrl    String?
  createdAt       DateTime @default(now())

  virtualNumber   VirtualNumber @relation(fields: [virtualNumberId], references: [id], onDelete: Cascade)

  @@index([virtualNumberId])
  @@index([createdAt])
}

model TrialPolicy {
  id              String   @id @default(cuid())
  name            String   @unique
  durationHours   Int      @default(24)
  maxNumbers      Int      @default(1)
  maxInboundSMS   Int      @default(3)
  maxOutboundSMS  Int      @default(0)
  maxInboundMinutes Int    @default(5)
  maxOutboundMinutes Int   @default(0)
  apiAllowed      Boolean  @default(false)
  eligibleCountries String? // comma-separated country codes, null = all
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CountryCapability {
  id              String   @id @default(cuid())
  countryCode     String   @unique
  country         String
  smsAllowed      Boolean  @default(true)
  voiceAllowed    Boolean  @default(true)
  mmsAllowed      Boolean  @default(false)
  identityRequired Boolean @default(false)
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
