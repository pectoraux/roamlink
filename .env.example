# RoamLink OS — Environment Variables
# Phase 12.4.6.3.1: PostgreSQL Test/Deployment Canonicalization.
#
# THREE DATABASE MODES:
#   A. Development database     → Neon PostgreSQL (DATABASE_URL)
#   B. Production database       → Neon PostgreSQL (DATABASE_URL)
#   C. Automated test database   → isolated PostgreSQL (DATABASE_TEST_URL)
#
# Do NOT use the shared production Neon database for the full test suite.
# Set DATABASE_TEST_URL to an isolated Neon branch/database for tests.
# If DATABASE_TEST_URL is absent, the PostgreSQL-authority matrix and smoke
# tests fall back to DATABASE_URL with strict per-run isolation — acceptable
# for those small suites ONLY.

# ---- A/B. Runtime database (dev + production) ----
# Neon PostgreSQL — pooled connection (PgBouncer) for app runtime.
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Neon PostgreSQL — direct connection for migrations (prisma migrate deploy).
# Must NOT use the pooled URL — migrations need a direct connection.
DIRECT_URL="postgresql://USER:PASS@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ---- C. Automated test database (isolated) ----
# Preferred: a dedicated Neon branch/database. When set, tests use this
# connection instead of DATABASE_URL. Leave unset only for the small
# PostgreSQL-authority matrix + smoke tests (which use strict isolation).
# DATABASE_TEST_URL="postgresql://USER:PASS@HOST-test-pooler.REGION.aws.neon.tech/test?sslmode=require"
# DIRECT_TEST_URL="postgresql://USER:PASS@HOST-test.REGION.aws.neon.tech/test?sslmode=require"

# ---- Rate limit configuration (Phase 12.4.6.3.1 Step 5) ----
# These are OPTIONAL. Production does NOT set them — the defaults in
# src/lib/api/rate-limit.ts apply (key=100, tenant=500, sensitive=10 per min).
# Tests override them to small values (e.g. 5) to prove the same DB-authoritative
# semantics with fewer requests. Setting them in production changes the policy
# and is NOT recommended without explicit capacity planning.
# RATE_LIMIT_KEY_PER_MINUTE=100
# RATE_LIMIT_TENANT_PER_MINUTE=500
# RATE_LIMIT_SENSITIVE_PER_MINUTE=10

# Cron secret (for /api/internal/* endpoints)
CRON_SECRET="change-me-to-a-long-random-cron-secret"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Platform admin
PLATFORM_ADMIN_EMAIL="admin@roamlink.local"
PLATFORM_ADMIN_PASSWORD="change-me"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
