# RoamLink OS — Environment Variables
# Phase 12.4.6.3.2: Test Database Safety + Remote Verification.
#
# THREE DATABASE MODES (STRICT — no production fallback):
#
#   DEVELOPMENT  → DATABASE_URL      = Neon development database
#   PRODUCTION   → DATABASE_URL      = Neon production database
#   TEST         → DATABASE_TEST_URL = isolated test PostgreSQL database (MANDATORY for tests)
#
# SECURITY CONTRACT (NON-NEGOTIABLE):
#   The test suite contains deleteMany, schema migrations, cleanup, destructive
#   fixtures, and concurrency tests. It MUST NEVER automatically connect to the
#   production Neon database.
#
#   if DATABASE_TEST_URL is absent
#       → the test command FAILS IMMEDIATELY (before Prisma initializes)
#
#   Never:
#     DATABASE_TEST_URL missing → use DATABASE_URL → possibly destroy production data
#
#   The test runner (tests/env.ts) enforces:
#     - DATABASE_TEST_URL is mandatory for all database-backed tests
#     - DATABASE_TEST_URL must NOT equal DATABASE_URL
#     - DATABASE_TEST_URL must NOT point to the same host as DATABASE_URL
#     - VERCEL_ENV=production → tests refuse to start
#     - NODE_ENV=production → tests refuse to start

# ---- DEVELOPMENT / PRODUCTION runtime database ----
# DATABASE_URL: Neon PostgreSQL — pooled connection (PgBouncer) for app runtime.
# Used by `next dev`, serverless functions. NOT for tests.
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# DIRECT_URL: Neon PostgreSQL — direct connection for migrations (prisma migrate deploy).
# Must NOT use the pooled URL — migrations need a direct connection.
# Used by `prisma migrate deploy` in production. NOT for test resets.
DIRECT_URL="postgresql://USER:PASS@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# ---- TEST database (isolated, MANDATORY for tests) ----
# DATABASE_TEST_URL: isolated PostgreSQL database for ALL database-backed tests.
# MUST be a separate database (Neon branch or dedicated test DB) — NEVER the
# production/dev database. Tests will FAIL to start without this set.
# The test harness (tests/env.ts) refuses to run if this is missing or equals DATABASE_URL.
DATABASE_TEST_URL="postgresql://USER:PASS@HOST-test-pooler.REGION.aws.neon.tech/test?sslmode=require"

# DIRECT_TEST_URL: direct connection for the test database (for test migrations/resets).
# Optional — defaults to DATABASE_TEST_URL if not set.
DIRECT_TEST_URL="postgresql://USER:PASS@HOST-test.REGION.aws.neon.tech/test?sslmode=require"

# ---- Rate limit configuration (Phase 12.4.6.3.1 Step 5) ----
# These are OPTIONAL. Production does NOT set them — the defaults in
# src/lib/api/rate-limit.ts apply (key=100, tenant=500, sensitive=10 per min).
# Tests override them to small values (e.g. 5) to prove the same DB-authoritative
# semantics with fewer requests. Setting them in production changes the policy
# and is NOT recommended without explicit capacity planning.
# RATE_LIMIT_KEY_PER_MINUTE=100
# RATE_LIMIT_TENANT_PER_MINUTE=500
# RATE_LIMIT_SENSITIVE_PER_MINUTE=10

# Cron secret (for /api/internal/* endpoints)
CRON_SECRET="change-me-to-a-long-random-cron-secret"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Platform admin
PLATFORM_ADMIN_EMAIL="admin@roamlink.local"
PLATFORM_ADMIN_PASSWORD="change-me"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
